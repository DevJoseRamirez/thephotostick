        "ggS8r_saPhM_text": "<p>Updated May 22, 2026</p>",
        "ggUEl1FaHZG_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/1681/4029/files/Articles_-_2026-05-21T165202.816.png",
        "ggVxyA1GJ5b_text": "<p>New Parent Advice</p>",
        "ggdTTzYvbql_text": "<p>Read time: 3 mins</p>",
        "ggsQdhQ4oSz_text": "<span style=\"background-color:transparent;color:#000000;\"><strong>I Thought My Baby Photos Were Safe… Until I Realized They Weren’t</strong></span> 😞",
        "ggz6zLhkoPw_text": "<p>Written by <strong>Savannah Long</strong></p>"
