        "ggOHXtEPlRb_successMessage": "Add product to cart successfully",
        "ggOHXtEPlRb_unavailableLabel": "Unavailable",
        "ggQesUdn4C8_text": "<p><strong>Customizable Photo Frame</strong></p>",
        "ggQne_5n9ae_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/2005/9307/files/gempages_432750572815254551-9d2a2a98-7aa9-4d10-ac13-0cc0b763c713.svg?v=1718348798",
        "ggQne_5n9ae_srcSet_tablet_src": "https://cdn.shopify.com/s/files/1/1681/4029/files/Icons_22.png",
        "ggRrl219-yt_text": "<p>Secure Checkout</p>",
        "ggUfHbbrPio_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(29,31,37);\">Give your precious memories the home they deserve. ThePhotoStick® Keepsake Frame Box is an elegant, gift-ready display box designed to hold your ThePhotoStick® Omni while showcasing a favorite photo on the front.</span></p>",
        "ggVevG23eea_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/2005/9307/files/gempages_432750572815254551-8a685f74-1ee2-4eab-a19e-17f5e720f623.svg?v=1718348722",
        "ggVevG23eea_srcSet_tablet_src": "https://cdn.shopify.com/s/files/1/1681/4029/files/Icons_17.png",
        "ggZsOP65o8V_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/2005/9307/files/gempages_432750572815254551-b1b8e8b4-1a58-40a9-9a81-c5ad8a1b619e.png?v=1716375140",
        "ggZsOP65o8V_srcSet_mobile_src": "https://cdn.shopify.com/s/files/1/1681/4029/files/20251116_033934.jpg",
        "ggZsOP65o8V_srcSet_tablet_src": "https://cdn.shopify.com/s/files/1/1681/4029/files/20251116_033934.jpg",
        "gga7aFDi-MY_text": "ThePhotoStick® Keepsake Frame Box",
        "ggaC7AZvrT-_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/2005/9307/files/gempages_432750572815254551-d76ff965-5eb9-4369-acf8-a935b85cbb3f.svg?v=1718348823",
        "ggaC7AZvrT-_srcSet_tablet_src": "https://cdn.shopify.com/s/files/1/1681/4029/files/Icons_19.png",
        "ggcc6Jh3vwb_text": "<p>30 Day Guarantee</p>",
        "ggckONzDw_M_background_mobile_image_src": "https://cdn.shopify.com/s/files/1/1681/4029/files/TPS_LP_Mobile_33.png",
        "ggckONzDw_M_background_tablet_image_src": "https://cdn.shopify.com/s/files/1/1681/4029/files/TPS_LP_Mobile_33.png",
        "ggiKOCRtT0t_text": "<p>Trusted by</p><p>2 Million+</p>",
        "ggm_HP19WfH_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(29,31,37);\">Personalize the front with a meaningful photo or one of the included inserts.</span></p>",
        "ggmq5AqBqrY_text": "<p>All shipments are sent by DHL Global Mail</p><p>You can track your shipment via the DHL Global Mail tracking system at <a href=\"https://webtrack.dhlglobalmail.com/\"><strong>https://webtrack.dhlglobalmail.com</strong></a></p><p>&nbsp;</p><p><span style=\"background-color:rgb(255,255,255);color:rgb(66,66,66);\">We offer a no-hassle, 30-Day Money Back Guarantee. If you’re not 100% satisfied with your purchase from ThePhotoStick®, our team will happily assist you with your return.&nbsp;</span></p>",
        "ggn5KcBHDKv_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(29,31,37);\">A delightful way to elevate your own space, beautifully preserving and showcasing memories you'll want to celebrate every day.</span></p>",
        "ggpDT2JjMb8_text": "<p>89+ Reviews</p>",
        "ggqpnCEQMQV_text": "<p>A stylish way to present ThePhotoStick Omni to parents, grandparents, or anyone who loves preserving and displaying meaningful memories.</p>",
        "ggsLbWM0bz9_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/2005/9307/files/gempages_432750572815254551-7382edec-3685-4565-b421-e96bbb0c96e3.png?v=1716375112",
        "ggsLbWM0bz9_srcSet_mobile_src": "https://cdn.shopify.com/s/files/1/1681/4029/files/KFB_Red_Family_1.png",
        "ggsLbWM0bz9_srcSet_tablet_src": "https://cdn.shopify.com/s/files/1/1681/4029/files/KFB_Red_Family_1.png",
        "ggx6FYywMWR_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/2005/9307/files/gempages_432750572815254551-1be461db-3fb2-4dd2-ae5f-875b1ce4bfc5.svg?v=1718348667",
        "ggx6FYywMWR_srcSet_tablet_src": "https://cdn.shopify.com/s/files/1/1681/4029/files/Icons_21.png",
        "ggy0s0EIoju_childItem_0": "<p>SPECIFICATIONS</p>",
        "ggy0s0EIoju_childItem_1": "<p>SHIPPING &amp; RETURNS</p>",
