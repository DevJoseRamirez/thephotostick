    "faq": {
      "type": "faq",
      "blocks": {
        "question-1": {
          "type": "question",
          "settings": {
            "title": "Can I use ThePhotoStick® Quick Click Remote to record videos?",
            "text": "<p>Yes! You can easily capture both photos and videos using our Bluetooth remote when it is connected to your device.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question-2": {
          "type": "question",
          "settings": {
            "title": "Which devices are compatible with the Quick Click Remote?",
            "text": "<p>Our remote pairs perfectly with phones and tablets operating on Android 4.2.2 OS or later / Apple iOS 6.0 or later.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question-3": {
          "type": "question",
          "settings": {
            "title": "How do I pair the Quick Click Remote with my device?",
            "text": "<p>Pairing with your device via Bluetooth is incredibly easy!</p><ol><li>Push the ON/OFF switch on the right side of the remote to the ON position.</li><li>Open your phone's Bluetooth settings and select ABSHUTTER3 from the list.</li><li>Open your phone's built-in camera app and line up your shot. Press the shutter button corresponding to your device type, then view your newest snapshot.</li></ol>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_GBG6m4": {
          "type": "question",
          "settings": {
            "title": "Does it require batteries / Are batteries included?",
            "text": "<p>ThePhotoStick Quick Click Remote requires one lithium battery (CR2032 X1 cell), which is included with your purchase.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_C6QznU": {
          "type": "question",
          "settings": {
            "title": "I already have a ton of apps taking up space on my phone! Will I have to download another one?",
            "text": "<p>The best thing about ThePhotoStick® Quick Click Remote is that it doesn't require additional app downloads. </p><p>Simply open your device's Bluetooth settings and select the remote from the list. In just a few seconds, you'll see that your connection has been successful, and you can instantly start snapping photos with your remote.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_X7CHbf": {
          "type": "question",
          "settings": {
            "title": "How does the 30 Day Money-Back Guarantee work?",
            "text": "<p>We offer a no-hassle, 30-Day Money Back Guarantee. If you’re not 100% satisfied with your purchase from ThePhotoStick®, our team is here to help you with a return. We want you to be happy!</p><p>If you are not completely satisfied with your order, please contact us at returns@thephotostick.com, and we'd be happy to facilitate your return and refund. For more information regarding our return process, check out our <a href=\"https://www.thephotostick.com/pages/support-return-and-refund-process\" target=\"_blank\">Returns and Refunds</a> page. </p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "contact": {
          "type": "contact",
          "settings": {
            "heading": "Didn’t find your answer?",
            "text": "<p>Don't hestitate to contact us</p>",
            "show_phone": false,
            "avatar_height": 60,
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
