    "rich_text_dhWtRq": {
      "type": "rich-text",
      "blocks": {
        "heading_UgFkfM": {
          "type": "heading",
          "settings": {
            "heading": "<em>Shipping Information</em> for ThePhotoStick®",
            "heading_size": "title-md",
