        "text_jUQygg": {
          "type": "text",
          "settings": {
            "text": "<p>Delivery times may be extended due to volume and carrier availability, and we are currently experiencing longer than normal shipping times to international destinations. Thank you for your patience as we work through this together!</p>",
            "text_font": "body",
            "text_size": "subtext-md",
            "text_max_size": 32,
            "text_line_height": 1.6,
            "text_letter_spacing": 0,
            "text_capitalize": false,
            "secondary_color": false,
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "text_ge7JNr": {
          "type": "text",
          "settings": {
            "text": "<p><strong>Standard Shipment Times Vary by Location:</strong></p><p><strong>US Destinations:</strong> 5-8 business days in transit<br/><br/><strong>Canada:</strong> 2-6 weeks in transit<br/><br/><strong>International Destinations:</strong> 2-8 weeks in transit<br/><em>*Please note that certain international destinations, such as Mexico and Israel, are experiencing longer shipping delays.</em></p>",
            "text_font": "body",
            "text_size": "subtext-md",
            "text_max_size": 32,
            "text_line_height": 1.6,
            "text_letter_spacing": 0,
            "text_capitalize": false,
