        "ggiKOCRtT0t_text": "<p>Trusted by</p><p>2 Million+</p>",
        "ggm_HP19WfH_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(29,31,37);\">Mesh pockets securely store cables, chargers, earphones, memory cards, SD cards, hard drives, lens filters, keys, and more.</span></p>",
