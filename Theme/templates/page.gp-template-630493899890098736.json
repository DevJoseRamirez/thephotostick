    "gp_section_630493900007998000": {
      "settings": {
        "checksum": "f164f0080c9e6b3b8bed1857a88b22971fffa35ab8a1448bde77d9ab8773e400_1_1_1_0__1",
        "gg2jUB7RshJ_text": "Strong, Sleek, Take-Anywhere Design",
        "ggAQ6DKvVLa_text": "<p>Built for life on the go, ThePhotoStick Omni features a compact, durable design that's easy to carry wherever you make memories.&nbsp;</p><p>&nbsp;</p><p>Slip it into a pocket, purse, backpack, or keychain and enjoy the confidence of having a simple backup solution always within reach.</p>",
        "ggHEkJw-liQ_background_desktop_image_src": "https://cdn.shopify.com/s/files/1/1681/4029/files/Serenity_Template_Rectangle_35.png",
        "ggHT22oAQI3_text": "<p>Some things are too important to leave unprotected.</p><p>&nbsp;</p><p>From treasured family photos and home videos to important documents, personal records, and files you rely on every day, ThePhotoStick Omni helps safeguard the digital pieces of your life. Everything that matters is backed up in one convenient place.</p>",
        "ggLYFg_NSJJ_text": "All-in-One Multi-Device Compatibility",
        "ggNeImPe4Vg_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/1681/4029/files/Omni_Back_Up_More.png",
        "ggZXKOtYeg1_text": "<p>Your memories aren't stored on just one device, so why should your backup only work with one?</p><p>&nbsp;</p><p>Back up photos and videos from iPhone®, Android™, Windows®, and Mac® devices using one simple solution. ThePhotoStick Omni helps you keep all your memories together, organized, and protected—without complicated setups or multiple backup tools.</p><p>&nbsp;</p>",
        "ggnmqaZgK38_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/1681/4029/files/Omni_Take_It_Anywhere.png",
        "ggu_PQLsjKY_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/1681/4029/files/Omni_All_In_One_Compatibility.png",
        "gguy9wSKlvE_background_desktop_image_src": "https://cdn.shopify.com/s/files/1/1681/4029/files/Serenity_Template_Rectangle_38.png",
        "gguy9wSKlvE_background_mobile_image_src": "https://cdn.shopify.com/s/files/1/1681/4029/files/Serenity_Template_Rectangle_38.png",
        "ggyk01pjb8v_background_desktop_image_src": "https://cdn.shopify.com/s/files/1/1681/4029/files/Serenity_Template_Rectangle_37.png",
        "ggyzGFJWVxj_text": "Back Up More Than Just Photos and Videos"
      },
      "type": "gp-section-630493900007998000"
    },
