    "gp_section_630493900007801392": {
      "settings": {
        "checksum": "6226b70fa03276563e9718705a90ad3d66d359ebc1b88205cbe6ff595d1c923f_1_1_1_0__1",
        "gg9wiixCmXU_text": "<p>Plug It Into Your Device</p>",
        "ggH_k4fdw50_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/1681/4029/files/Steps_Omni_Classic_03.png",
        "ggIFJdNCWZs_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/1681/4029/files/Steps_Omni_Classic_01.png",
        "ggK64ExjM6U_text": "<p>Download the FREE App</p>",
        "ggLDyMOpOm1_text": "<p>Download ThePhotoStick Omni app from the Google Play Store or Apple App Store.</p>",
        "ggNEUj3JVk1_text": "Get Started In 3 Easy Steps",
        "ggNKRHAofgc_text": "<p>Plug ThePhotoStick Omni into your Android or Apple device and follow the on-screen instructions.</p>",
        "ggZ51lpM5_V_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/1681/4029/files/Articles_-_2026-06-04T143513.634.png",
        "ggm61xDnTBH_text": "<p>Plug it into your computer to safely and easily transfer your photos and videos.</p>",
        "ggxpsZtk0cz_text": "<p>Safely Transfer Files</p>"
      },
      "type": "gp-section-630493900007801392"
    },
    "gp_section_630493900007866928": {
      "settings": {
        "checksum": "d0009809962c00ea1580260965265b144105c3cd3976cb651310b148c4ae3b85_1_1_1_0__1",
        "gg-qRaKtm2I_text": "<p><i>Merri D.</i></p>",
        "gg0Xy-YqjJk_text": "<p>\"This stick holds thousands of pictures and videos. Then you can plug it in to your TV or laptop and look through the pictures or watch the videos. No more buying storage or being afraid of losing your memories if you phone breaks. I am going to get one for everyone in my household so they can always have their memories saved.\"</p>",
        "gg9i4IgKp6w_text": "Join Over 2 Million+ ThePhotoStick® Users Worldwide",
        "ggBtSqotnCn_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/1681/4029/files/Omni_Classic_review_img_01.png",
        "ggDxURGJW-L_text": "<p>\"This is one of those devices that you never knew you needed until you got one. My phone is loaded with thousands of photos, so when I want to find one, it takes a long time. With this nifty little gadget, I can now offload all of those photos that I can't bring myself to delete and start over with a clean slate.\"</p>",
        "ggPgMGwR4JB_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/1681/4029/files/Omni_Classic_review_img_03.png",
        "ggPyVyK4UcU_text": "<p><i>Sherry H.</i></p>",
        "ggS2BQLjIxB_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/1681/4029/files/Omni_Classic_review_img_02.png",
        "ggbdGyeppWz_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/1681/4029/files/Omni_Classic_review_img_04.png",
        "gglf50QRubB_text": "<p>\"I’m “one of those” whose pictures data spans over several years and amassing over 19,000, I finally caved and ordered this stick. It was so easy to download— uploaded the app, uploaded the photos and are now running on electronic picture library. Love it.\"</p>",
        "ggqsIlgM4FS_text": "<p><span style=\"background-color:rgba(255,255,255,0);color:rgb(54,54,54);\">\"I have been kicking this purchase around for too long. Finally pulled the trigger and I couldn't be happier with the results. Very easy to use. I backed up everything from my Android phone then transferred all of those files to my laptop. Very happy with this purchase.\"</span></p>",
        "ggxRiV5kOUa_text": "<p><i>Leslie B.</i></p>",
        "ggxSxXrG2X1_text": "<p><i>Joseph L.</i></p>"
      },
      "type": "gp-section-630493900007866928"
    },
    "gp_section_630493900007932464": {
      "settings": {
        "checksum": "6059440dd35b1ab931308283e718f45d9f2c522ff8371e543c4264003bfe2650_1_1_1_0__1",
        "ggppt329Eyw_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/1681/4029/files/TPS_Omni_Logo.png",
