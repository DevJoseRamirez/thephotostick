    "gp_section_630493900008129072": {
      "settings": {
        "checksum": "74f2cb4d4c27a54ea9eb5b0fa33e9c92e33aea0bb1633dc5b6fd605d0ff04f2b_1_1_1_0__1",
        "gg0WUXbidyH_text": "<p>Simply download ThePhotoStick Omni app, plug ThePhotoStick Omni into your device, and tap 'BACK UP FILES NOW,' and that's it! Sit back and relax as it automatically finds and saves all of your precious photos, videos, and more.</p>",
        "gg88rERqeSs_text": "<p>Starting your backup is easy as 1, 2, 3!</p>",
        "ggF4BqBpf5g_text": "<p>Find and Protect 100,000+ photos and videos</p>",
        "ggKY0K-vSJw_text": "<p>Approximate number of files stored on ThePhotoStick Omni USB:</p><p>&nbsp;</p><p>16GB - 6,400 photos and videos</p><p>32 GB - 12,800 photos and videos<br>64 GB - 25,600 photos and videos<br>128 GB - 51,200 photos and videos<br>256 GB - 102,400 photos and videos</p>",
        "ggNqJkh1FQO_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/1681/4029/files/Omni_Classic_BackUp_Made_Easy_01.png",
        "ggOxhTHJGtX_text": "<p>Works with Android, iPhone, and iPad devices</p>",
        "ggPhIMrEmg2_text": "<p>ThePhotoStick Omni is compatible with Windows, Android, and Apple Operating Systems:<br><br>- Windows: Windows 7 SP1 and later<br>- Apple: iOS and iPadOS 13.0 and later<br>- Android: 6.0 and later</p>",
        "ggcB-8AjZvk_text": "Photo &amp; Video Backups Made Easy",
        "ggey30_3Kms_childItem_0": "<p>Compatibility</p>",
        "ggey30_3Kms_childItem_1": "<p>Capacity</p>",
        "ggey30_3Kms_childItem_2": "<p>Getting Started</p>"
      },
      "type": "gp-section-630493900008129072"
    },
