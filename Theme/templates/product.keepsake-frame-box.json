    "faq": {
      "type": "faq",
      "blocks": {
        "question-1": {
          "type": "question",
          "settings": {
            "title": "Does ThePhotoStick® Omni come with the Keepsake Frame Box?",
            "text": "<p>ThePhotoStick Omni is sold separately unless otherwise specified as part of a bundle. The Keepsake Frame Box is designed as the perfect add-on to make your ThePhotoStick Omni more giftable and display-ready.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question-2": {
          "type": "question",
          "settings": {
            "title": "Can I add my own photo to the frame?",
            "text": "<p>Yes! Simply add a favorite family photo, vacation memory, milestone moment, or other special picture to personalize your Keepsake Frame Box.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question-3": {
          "type": "question",
          "settings": {
            "title": "What if I don’t have a photo ready to put in the frame?",
            "text": "<p>No problem! The Keepsake Frame Box includes multiple inserts that can be displayed in place of a personal photo. This makes it easy to create a polished, gift-ready presentation even when you don’t have time to print a picture.</p><p></p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question-4": {
          "type": "question",
          "settings": {
            "title": "What is the Keepsake Frame Box made from?",
            "text": "<p>The box features a sleek black leather outer case with an inner drawer constructed from kraft and EVA materials, creating an attractive combination of presentation and protective storage.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_X7CHbf": {
          "type": "question",
          "settings": {
            "title": "How does the 30 Day Money-Back Guarantee work?",
            "text": "<p>We offer a no-hassle, 30-Day Money Back Guarantee. If you’re not 100% satisfied with your purchase from ThePhotoStick®, our team is here to help you with a return. We want you to be happy!</p><p>If you are not completely satisfied with your order, please contact us at returns@thephotostick.com, and we'd be happy to facilitate your return and refund. For more information regarding our return process, check out our <a href=\"https://www.thephotostick.com/pages/support-return-and-refund-process\" target=\"_blank\">Returns and Refunds</a> page. </p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "contact": {
          "type": "contact",
          "settings": {
            "heading": "Didn’t find your answer?",
            "text": "<p>Don't hestitate to contact us</p>",
            "show_phone": false,
            "avatar_height": 60,
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
