    "faq": {
      "type": "faq",
      "blocks": {
        "question-1": {
          "type": "question",
          "settings": {
            "title": "Can I charge my phone while using ThePhotoStick® Omni?",
            "text": "<p>Yes! ChargeLink is designed to let compatible USB-C phones stay connected to a charger while ThePhotoStick Omni is connected via the USB-A port.</p><p>You can also charge your phone or tablet while using other USB-A flash drives.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question-2": {
          "type": "question",
          "settings": {
            "title": "Does ChargeLink transfer data?",
            "text": "<p>Yes. When connected to a compatible host device, the USB-A connection supports USB 2.0 data transfer.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question-3": {
          "type": "question",
          "settings": {
            "title": "What devices is ChargeLink compatible with?",
            "text": "<p>ChargeLink works with many compatible USB-C devices, including iPhone 16 and 17 series devices, USB-C iPads, Samsung Galaxy phones, Android phones and tablets, MacBooks, laptops, PCs, and other supported USB-C devices.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_iwphTP": {
          "type": "question",
          "settings": {
            "title": "Does ChargeLink require an app, driver, or additional software?",
            "text": "<p>No additional drivers or ChargeLink-specific software are required. Simply connect it to your compatible devices. ThePhotoStick® Omni will still require its normal app or software when applicable.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_HaN98n": {
          "type": "question",
          "settings": {
            "title": "Can I use ChargeLink with a wall charger or car charger?",
            "text": "<p>Yes. ChargeLink can be connected to compatible USB wall or car chargers to power supported USB-C mobile devices when another compatible USB accessory is connected.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_zcYLHm": {
          "type": "question",
          "settings": {
            "title": "Will ChargeLink work with Lightning-port iPhones?",
            "text": "<p>ChargeLink uses a USB-C male connector, so it is intended for devices with a USB-C port. It does not connect directly to iPhones that use a Lightning port.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_8CQjHh": {
          "type": "question",
          "settings": {
            "title": "Can ChargeLink charge laptops or other high-powered USB-C devices?",
            "text": "<p>ChargeLink is designed to support charging for compatible mobile phones and other low-power USB-C devices. Charging performance and compatibility may vary by device and power source.</p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "question_X7CHbf": {
          "type": "question",
          "settings": {
            "title": "How does the 30 Day Money-Back Guarantee work?",
            "text": "<p>We offer a no-hassle, 30-Day Money Back Guarantee. If you’re not 100% satisfied with your purchase from ThePhotoStick®, our team is here to help you with a return. We want you to be happy!</p><p>If you are not completely satisfied with your order, please contact us at returns@thephotostick.com, and we'd be happy to facilitate your return and refund. For more information regarding our return process, check out our <a href=\"https://www.thephotostick.com/pages/support-return-and-refund-process\" target=\"_blank\">Returns and Refunds</a> page. </p>",
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        },
        "contact": {
          "type": "contact",
          "settings": {
            "heading": "Didn’t find your answer?",
            "text": "<p>Don't hestitate to contact us</p>",
            "show_phone": false,
            "avatar_height": 60,
            "highlighted_text": "none",
            "highlighted_scribble": "circle"
          }
        }
      },
