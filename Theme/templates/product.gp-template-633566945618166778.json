        "ggiKOCRtT0t_text": "<p>Trusted by</p><p>2 Million+</p>",
        "ggm_HP19WfH_text": "<p><span style=\"background-color:rgb(255,255,255);color:rgb(29,31,37);\">Comes with a handy carabiner, allowing you to easily attach it to your bag, belt loop, or backpack. Perfect for on-the-go adventures!</span></p>",
