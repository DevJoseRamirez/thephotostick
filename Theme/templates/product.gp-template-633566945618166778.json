        "ggaC7AZvrT-_srcSet_desktop_src": "https://cdn.shopify.com/s/files/1/2005/9307/files/gempages_432750572815254551-d76ff965-5eb9-4369-acf8-a935b85cbb3f.svg?v=1718348823",
        "ggaC7AZvrT-_srcSet_tablet_src": "https://cdn.shopify.com/s/files/1/1681/4029/files/Icons_19.png",
        "ggcc6Jh3vwb_text": "<p>30 Day Guarantee</p>",
        "ggckONzDw_M_background_mobile_image_src": "https://cdn.shopify.com/s/files/1/1681/4029/files/TPS_LP_Mobile_33.png",
