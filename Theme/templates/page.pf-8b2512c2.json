        "pf_cac2020c_code": "<style>\n.abar-countdown {\n  display: flex;\n  padding: 5px;\n  text-align: center;\n  color: #fff;\n}\n\n.abar-countdown ul {\n  margin: 0;\n  padding: 0;\n  display: flex;\n  justify-self: center;\n  align-self: center;\n}\n\n.abar-countdown li {\n  font-size: 1.3rem;\n  list-style-type: none;\n  padding: 3px;\n  text-transform: uppercase;\n  font-family: 'Montserrat', Arial, Helvetica, sans-serif;\n}\n\n.abar-countdown li span {\n  display: block;\n  font-size: 3rem;\n  font-family: 'Montserrat', Arial, Helvetica, sans-serif;\n  margin-bottom: -10px;\n}\n</style>\n<div class=\"abar-countdown\">\n  <ul>\n\t<li><span id=\"abar-days\">03</span>Days</li>\n\t<li><span id=\"abar-hours\">03</span>Hours</li>\n\t<li><span id=\"abar-minutes\">03</span>Minutes</li>\n\t<li><span id=\"abar-seconds\">03</span>Seconds</li>\n  </ul>\n</div>\n<script>\n(function() {\n  const second = 1000,\n        minute = second * 60,\n        hour = minute * 60,\n        day = hour * 24\n  \n  var eventFullDate = new Date()\n  //document.getElementById(\"countshow\").innerHTML = eventFullDate\n  eventFullDate.setHours(eventFullDate.getHours() + 3)\n  eventFullDate.setMinutes(eventFullDate.getMinutes() + 12)\n  eventFullDate.setSeconds(eventFullDate.getSeconds() + 46)\n  \n  //grab time from cookie\n  if (window.localStorage.getItem(\"time\") !== null) {\n  eventFullDate = window.localStorage.getItem(\"time\")\n  }\n  //add cookie with time to client\n  window.addEventListener(\"beforeunload\", function() {\n\t  window.localStorage.setItem(\"time\", eventFullDate)\n  })\n  \n  //countdown\n  var countdown = new Date(eventFullDate).getTime(), x = setInterval(function() {\n\t  const now = new Date().getTime(), distance = countdown - now\n    //for testing\n\t  //document.getElementById(\"countshow\").innerHTML = distance\n    //document.getElementById(\"cookie\").innerHTML = window.localStorage.getItem(\"time\")\n    \n    //set display\n    document.getElementById(\"abar-days\").innerHTML = Math.floor(distance / (day)),\n    document.getElementById(\"abar-hours\").innerHTML = Math.floor((distance % (day)) / (hour)),\n    document.getElementById(\"abar-minutes\").innerHTML = Math.floor((distance % (hour)) / (minute)),\n    document.getElementById(\"abar-seconds\").innerHTML = Math.floor((distance % (minute)) / second)\n    \n    //reset countdown timer to be 3hours, 12min, 46seconds ahead when limit reached\n    if (distance < 0) {\n      // eventFullDate = new Date()\n      // eventFullDate.setHours(eventFullDate.getHours() + 0),\n      // eventFullDate.setMinutes(eventFullDate.getMinutes() + 0),\n      // eventFullDate.setSeconds(eventFullDate.getSeconds() + 10)\n      countdown = new Date()\n      countdown.setHours(countdown.getHours() + 3),\n      countdown.setMinutes(countdown.getMinutes() + 12),\n      countdown.setSeconds(countdown.getSeconds() + 46)\n      window.localStorage.setItem(\"time\", countdown)\n      countdown = countdown.getTime()\n      // alert(countdown)\n      // clearInterval(x)\n    }\n  }, 0)\n}())\n</script>",
        "pf_e3ddaa9d_code": "<style>\n.mabar-countdown {\n  display: flex;\n  padding: 5px;\n  text-align: center;\n  color: #fff;\n}\n\n.mabar-countdown ul {\n  margin: 0;\n  padding: 0;\n  display: flex;\n  justify-self: center;\n  align-self: center;\n}\n\n.mabar-countdown li {\n  font-size: 1rem;\n  list-style-type: none;\n  padding: 3px;\n  text-transform: uppercase;\n}\n\n.mabar-countdown li span {\n  display: block;\n  font-size: 2.4rem;\n      margin-bottom: -6px;\n  font-family: 'Montserrat', Arial, Helvetica, sans-serif;\n}\n</style>\n<div class=\"mabar-countdown\">\n  <ul>\n\t<li><span id=\"mabar-days\">03</span>Days</li>\n\t<li><span id=\"mabar-hours\">03</span>Hours</li>\n\t<li><span id=\"mabar-minutes\">03</span>Minutes</li>\n\t<li><span id=\"mabar-seconds\">03</span>Seconds</li>\n  </ul>\n</div>\n<script>\n(function() {\n  const second = 1000,\n        minute = second * 60,\n        hour = minute * 60,\n        day = hour * 24\n  \n  var eventFullDate = new Date()\n  //document.getElementById(\"countshow\").innerHTML = eventFullDate\n  eventFullDate.setHours(eventFullDate.getHours() + 3)\n  eventFullDate.setMinutes(eventFullDate.getMinutes() + 12)\n  eventFullDate.setSeconds(eventFullDate.getSeconds() + 46)\n  \n  //grab time from cookie\n  if (window.localStorage.getItem(\"time\") !== null) {\n  eventFullDate = window.localStorage.getItem(\"time\")\n  }\n  //add cookie with time to client\n  window.addEventListener(\"beforeunload\", function() {\n\t  window.localStorage.setItem(\"time\", eventFullDate)\n  })\n  \n  //countdown\n  var countdown = new Date(eventFullDate).getTime(), x = setInterval(function() {\n\t  const now = new Date().getTime(), distance = countdown - now\n    //for testing\n\t  //document.getElementById(\"countshow\").innerHTML = distance\n    //document.getElementById(\"cookie\").innerHTML = window.localStorage.getItem(\"time\")\n    \n    //set display\n    document.getElementById(\"mabar-days\").innerHTML = Math.floor(distance / (day)),\n    document.getElementById(\"mabar-hours\").innerHTML = Math.floor((distance % (day)) / (hour)),\n    document.getElementById(\"mabar-minutes\").innerHTML = Math.floor((distance % (hour)) / (minute)),\n    document.getElementById(\"mabar-seconds\").innerHTML = Math.floor((distance % (minute)) / second)\n    \n    //reset countdown timer to be 3hours, 12min, 46seconds ahead when limit reached\n    if (distance < 0) {\n      // eventFullDate = new Date()\n      // eventFullDate.setHours(eventFullDate.getHours() + 0),\n      // eventFullDate.setMinutes(eventFullDate.getMinutes() + 0),\n      // eventFullDate.setSeconds(eventFullDate.getSeconds() + 10)\n      countdown = new Date()\n      countdown.setHours(countdown.getHours() + 3),\n      countdown.setMinutes(countdown.getMinutes() + 12),\n      countdown.setSeconds(countdown.getSeconds() + 46)\n      window.localStorage.setItem(\"time\", countdown)\n      countdown = countdown.getTime()\n      // alert(countdown)\n      // clearInterval(x)\n    }\n  }, 0)\n}())\n</script>",
        "pf_b6a24429_value": "<a href=\"https://www.thephotostick.com/pages/about-us\" target=\"_blank\" style=\"color: rgb(255, 255, 255);\">About Us</a>&nbsp; &nbsp; &nbsp;<a href=\"https://www.thephotostick.com/pages/support\" target=\"_blank\" style=\"color: rgb(255, 255, 255);\">Contact Us</a>&nbsp; &nbsp; &nbsp;<a href=\"https://www.thephotostick.com/pages/terms-conditions\" target=\"_blank\" style=\"color: rgb(255, 255, 255);\">Terms & Conditions</a>&nbsp; &nbsp; &nbsp;<a href=\"https://www.thephotostick.com/pages/privacy-policy\" target=\"_blank\" style=\"color: rgb(255, 255, 255);\">Privacy Po<sup></sup><sup></sup>licy</a>",
        "pf_2ba56e9b_value": "ThePhotoStick® Cube instantly turns your iPhone charger into a powerful backup device. It makes finding and protecting all your photo and video memories as easy as plugging in your phone to a traditional wall charger. ThePhotoStick® Cube is perfect for anyone who enjoys taking photos on their iPhone but wants to keep their memories safe and organized without paying monthly fees for iCloud.\n",
        "pf_4270c5b9_value": "ThePhotoStick® Cube comes with a removable memory card. Once the memory card is full of your photo and video memories, simply replace it with any memory card. There is no limit to the number of memories you can protect! Choose from 4 sizes of memory cards: 32GB, 64GB, 128GB, and 256GB.",
        "pf_d3547e5d_value": "I had a grand total of about 60,000 images, with many duplicates. This little \"stick\" managed to eliminate the duplicates so that I now have about 24,00 originals preserved forever in a fire-proof vault, a cost-free and independent method of safekeeping.",
        "pf_f01995dd_value": "After downloading the FREE app, simply plug ThePhotoStick® Cube into your phone charger and, as your phone begins charging, it will automatically start to back up your photos and videos. No complicated setup, logins, or software to install!",
        "pf_85ae2c4a_value": "So easy to use. Can move tons of old keepable photos off my other devices and onto this stick. I must have moved 500 photos to the stick and the \"needle\" barely moved. Totally happy with it - especially at a rather low cost.",
        "pf_cb21587d_value": "ThePhotoStick® Cube keeps all your most important files right at your fingertips, so they're easily accessible on any device, without an internet connection, when you need them – yet stored safely and away from hackers.",
        "pf_98ed1d64_value": "Works just the way it says it does; very easy to use. I checked it when done, and there were my pictures. There is so much room on the stick that I should be able to use it for years to backup documents and pictures.",
        "pf_519c67b3_value": "No need to waste money every month by storing files on iCloud. Your photos and videos are stored on a specially designed USB drive and remain under your control\n",
        "pf_d4640d9e_value": "Don’t risk losing the irreplaceable photo and video memories on your iPhone. ThePhotoStick Cube automatically backs them up any time you charge your phone!\n",
        "pf_fd628001_value": "Your phone contains many photos and videos of loved ones and special occasions. Don’t risk losing them to a technical fault or a lost or broken phone.\n",
        "pf_4811d421_value": "No complicated setup, logins, or software to install! Simply download the free app, connect ThePhotoStick Cube to your iPhone charger and hit ‘Go’\n",
        "pf_742c0515_value": "Whether you have an iPhone, iPad, or iPod Touch, ThePhotoStick Cube will find and secure all of your irreplaceable photo and video memories\n",
        "pf_823e225c_value": "Works on most Apple devices, including iPhone, iPad, and iPod Touch. Devices must have a Lightning Port and iOS 10.13 or later.",
        "pf_b43e3174_value": "<span style=\"font-weight: bold; text-decoration-line: underline;\">See Our FAQs</span>",
        "pf_19a866a1_value": "Automatically organizes your files neatly into folders so they’re easy to find.\r\r",
