            { color: "Yellow", variantId: "43828431487112", image: "https://cdn.shopify.com/s/files/1/1681/4029/files/QCR_YellowListing_5fc6e537-9e89-4819-9128-0775653473fe.png?v=1753210512" },
            { color: "Red", variantId: "43828431519880", image: "https://cdn.shopify.com/s/files/1/1681/4029/files/QCR_RedListing_098b5843-204a-4f0c-969d-b8c49bdfc132.png?v=1753210512" }
          ]
        },
        case: {
          defaultColor: "Black",
          variants: [
            { color: "Black", variantId: "43828577599624", image: "https://cdn.shopify.com/s/files/1/1681/4029/files/TTC_Black_Listing.png?v=1759241873" },
            { color: "Blue", variantId: "43828577632392", image: "https://cdn.shopify.com/s/files/1/1681/4029/files/TTC_Blue_Listing.png?v=1759241873" },
            { color: "Purple", variantId: "43828577665160", image: "https://cdn.shopify.com/s/files/1/1681/4029/files/TTC_Purple_Listing.png?v=1759241873" },
            { color: "Orange", variantId: "43828577697928", image: "https://cdn.shopify.com/s/files/1/1681/4029/files/TTC_Orange_Listing.png?v=1759241873" },
            { color: "Yellow", variantId: "43828577730696", image: "https://cdn.shopify.com/s/files/1/1681/4029/files/TTC_Yellow_Listing.png?v=1759241873" },
            { color: "Red", variantId: "43828577763464", image: "https://cdn.shopify.com/s/files/1/1681/4029/files/TTC_Red_Listing.png?v=1759241873" }
          ]
        }
      }
    };

    var root = document.getElementById("tps-classic-checkout");
    if (!root) return;

    var slider = root.querySelector("#tpscSlider");
    var thumbRow = root.querySelector("#tpscThumbRow");
    var prevBtn = root.querySelector(".tpsc-gallery-prev");
    var nextBtn = root.querySelector(".tpsc-gallery-next");
    var sizeOptions = root.querySelector("#tpscSizeOptions");
    var selectedPrice = root.querySelector("#tpscSelectedPrice");
    var selectedCompare = root.querySelector("#tpscSelectedCompare");
    var remoteCheckbox = root.querySelector("#tpscRemoteCheckbox");
    var remoteSelect = root.querySelector("#tpscRemoteSelect");
    var remoteImage = root.querySelector("#tpscRemoteImage");
    var caseCheckbox = root.querySelector("#tpscCaseCheckbox");
    var caseSelect = root.querySelector("#tpscCaseSelect");
    var caseImage = root.querySelector("#tpscCaseImage");
    var checkoutBtn = root.querySelector("#tpscCheckoutBtn");
    var videoRow = root.querySelector("#tpscVideoRow");
    var videoPrevBtn = root.querySelector(".tpsc-video-prev");
    var videoNextBtn = root.querySelector(".tpsc-video-next");

    var selectedSizeId = tpscConfig.defaultSizeId;
    var currentGalleryIndex = 0;
    var galleryProgrammaticScroll = false;
    var galleryScrollSettleTimer = null;
    var currentVideoIndex = 0;

    function findSize(sizeId) {
      for (var i = 0; i < tpscConfig.sizes.length; i++) {
        if (tpscConfig.sizes[i].id === sizeId) return tpscConfig.sizes[i];
      }
      return tpscConfig.sizes[0];
    }

    function findAddonVariant(type, color) {
      var addon = tpscConfig.addons[type];
      if (!addon || !addon.variants || !addon.variants.length) return null;

      for (var i = 0; i < addon.variants.length; i++) {
        if (addon.variants[i].color === color) return addon.variants[i];
      }

      return addon.variants[0];
    }

    function updateDynamicAxonBuyClass(size) {
      if (!checkoutBtn || !size || !size.axonBuyClass) return;

      checkoutBtn.classList.remove(
        "axon-dyn-buy-32",
        "axon-dyn-buy-64",
        "axon-dyn-buy-128",
        "axon-dyn-buy-256",
        "axon-dyn-buy-512"
      );

      checkoutBtn.classList.add(size.axonBuyClass);
      checkoutBtn.setAttribute("data-axon-selected-size-id", size.id || "");
      checkoutBtn.setAttribute("data-axon-selected-size-label", size.label || "");
      checkoutBtn.setAttribute("data-axon-selected-variant-id", size.variantId || "");
      checkoutBtn.setAttribute("data-axon-buy-class", size.axonBuyClass || "");
    }

    function setGalleryByIndex(index, skipScroll) {
      if (!tpscConfig.galleryImages.length) return;
      if (index < 0) index = tpscConfig.galleryImages.length - 1;
      if (index >= tpscConfig.galleryImages.length) index = 0;
      currentGalleryIndex = index;

      if (slider && !skipScroll) {
        var slides = slider.querySelectorAll(".tpsc-slide");
        if (slides[index]) {
          var targetLeft = slides[index].offsetLeft - slider.offsetLeft;

          galleryProgrammaticScroll = true;
          window.clearTimeout(galleryScrollSettleTimer);
          // Safety net: release the lock even if the scroll never lands exactly.
          galleryScrollSettleTimer = window.setTimeout(function () {
            galleryProgrammaticScroll = false;
          }, 700);

          if (typeof slider.scrollTo === "function") {
            slider.scrollTo({ left: targetLeft, behavior: "smooth" });
          } else {
            slider.scrollLeft = targetLeft;
          }
        }
      }

      updateThumbState(tpscConfig.galleryImages[currentGalleryIndex].id);
    }

    function syncGalleryIndexFromScroll() {
      if (!slider) return;
      var slides = slider.querySelectorAll(".tpsc-slide");
      if (!slides.length) return;

      var sliderRect = slider.getBoundingClientRect();
      var sliderCenter = sliderRect.left + (sliderRect.width / 2);

      var closestIndex = 0;
      var closestDistance = Infinity;

      for (var i = 0; i < slides.length; i++) {
        var rect = slides[i].getBoundingClientRect();
        var slideCenter = rect.left + (rect.width / 2);
        var distance = Math.abs(slideCenter - sliderCenter);
        if (distance < closestDistance) {
          closestDistance = distance;
          closestIndex = i;
        }
      }

      if (galleryProgrammaticScroll) {
        // Ignore intermediate frames of our own smooth scroll; only clear once it lands.
        if (closestIndex === currentGalleryIndex) {
          galleryProgrammaticScroll = false;
          window.clearTimeout(galleryScrollSettleTimer);
        }
        return;
      }

      if (closestIndex !== currentGalleryIndex) {
        currentGalleryIndex = closestIndex;
        updateThumbState(tpscConfig.galleryImages[currentGalleryIndex].id);
      }
    }

    function updateThumbState(activeId) {
      var thumbs = root.querySelectorAll(".tpsc-thumb");
      for (var i = 0; i < thumbs.length; i++) {
        var isActive = thumbs[i].getAttribute("data-image-id") === activeId;
        thumbs[i].classList.toggle("is-active", isActive);
        if (isActive) scrollThumbIntoView(thumbs[i]);
      }
    }

    function scrollThumbIntoView(thumb) {
      if (!thumbRow || !thumb) return;
      var rowWidth = thumbRow.clientWidth;
      var target = thumb.offsetLeft - (rowWidth / 2) + (thumb.offsetWidth / 2);
      var maxScroll = thumbRow.scrollWidth - rowWidth;
      if (target < 0) target = 0;
      if (target > maxScroll) target = maxScroll;
      if (typeof thumbRow.scrollTo === "function") {
        thumbRow.scrollTo({ left: target, behavior: "smooth" });
      } else {
        thumbRow.scrollLeft = target;
      }
    }

    // Ask Shopify's CDN for an appropriately-sized copy instead of the full-res original.
    // Handles cdn.shopify.com and custom storefront domains (/cdn/shop/...).
    function cdnResize(url, width) {
      if (!url || typeof url !== "string") return url;

      var isShopifyCdn = url.indexOf("cdn.shopify.com") !== -1 || url.indexOf("/cdn/shop/") !== -1;
      if (!isShopifyCdn) return url;

      // Strip any width/height already on the URL so ours takes effect.
      var cleaned = url.replace(/([?&])(width|height)=\d+/g, "$1").replace(/[?&]+$/, "");
      cleaned = cleaned.replace(/\?&/, "?").replace(/&&+/g, "&");

      var dpr = window.devicePixelRatio > 1 ? 2 : 1;
      var target = width * dpr;
      return cleaned + (cleaned.indexOf("?") === -1 ? "?" : "&") + "width=" + target;
    }

    function buildGallery() {
      var images = tpscConfig.galleryImages;

      if (slider) {
        slider.innerHTML = "";
        for (var s = 0; s < images.length; s++) {
          var slide = document.createElement("div");
          slide.className = "tpsc-slide";
          slide.setAttribute("data-image-id", images[s].id);
          slide.innerHTML =
            '<img class="tpsc-main-image" src="' + cdnResize(images[s].src, 620) + '" alt="' +
            (images[s].alt || "ThePhotoStick Omni") + '" loading="' + (s === 0 ? "eager" : "lazy") +
            '" decoding="async" draggable="false">';
          slider.appendChild(slide);
        }
      }

      if (!thumbRow) return;
      thumbRow.innerHTML = "";
      for (var i = 0; i < images.length; i++) {
        (function (image, index) {
          var btn = document.createElement("button");
          btn.type = "button";
          btn.className = "tpsc-thumb";
          btn.setAttribute("data-image-id", image.id);
          btn.setAttribute("aria-label", image.alt || "View image");
          btn.innerHTML = '<img src="' + cdnResize(image.thumb, 200) + '" alt="' + (image.alt || "Product image") + '" loading="lazy" decoding="async">';
          btn.addEventListener("click", function () {
            setGalleryByIndex(index);
          });
          thumbRow.appendChild(btn);
        })(images[i], i);
      }
    }

    function buildSizes() {
      if (!sizeOptions) return;
      sizeOptions.innerHTML = "";
      for (var i = 0; i < tpscConfig.sizes.length; i++) {
        (function (size) {
          var btn = document.createElement("button");
          btn.type = "button";
          btn.className = "tpsc-size-btn";
          btn.setAttribute("data-size-id", size.id);
          btn.setAttribute("aria-label", "Select " + size.label);
          btn.innerHTML = '<img src="' + cdnResize(size.image, 100) + '" alt="' + size.label + '" loading="lazy" decoding="async"><span>' + size.label + '</span>';
          btn.addEventListener("click", function () {
            selectSize(size.id, true);
          });
          sizeOptions.appendChild(btn);
        })(tpscConfig.sizes[i]);
      }
    }

    function selectSize(sizeId, shouldSwapImage) {
      selectedSizeId = sizeId;
      var size = findSize(selectedSizeId);
      if (selectedPrice) selectedPrice.textContent = size.salePrice;
      if (selectedCompare) selectedCompare.textContent = size.comparePrice;

      var buttons = root.querySelectorAll(".tpsc-size-btn");
      for (var i = 0; i < buttons.length; i++) {
        buttons[i].classList.toggle("is-selected", buttons[i].getAttribute("data-size-id") === selectedSizeId);
      }

      updateDynamicAxonBuyClass(size);

      if (shouldSwapImage && slider) {
        // Slide 0 is the product shot; repoint it at the selected size and scroll there.
        var firstSlideImg = slider.querySelector(".tpsc-slide .tpsc-main-image");
        if (firstSlideImg) {
          firstSlideImg.src = cdnResize(size.image, 620);
          firstSlideImg.alt = "ThePhotoStick Omni " + size.label;
        }
        var firstThumbImg = root.querySelector(".tpsc-thumb img");
        if (firstThumbImg) firstThumbImg.src = cdnResize(size.image, 200);
        setGalleryByIndex(0);
      }
    }

    function buildAddonSelect(type, selectEl) {
      if (!selectEl) return;
      var addon = tpscConfig.addons[type];
      selectEl.innerHTML = "";
      for (var i = 0; i < addon.variants.length; i++) {
        var option = document.createElement("option");
        option.value = addon.variants[i].color;
        option.textContent = addon.variants[i].color;
        if (addon.variants[i].color === addon.defaultColor) option.selected = true;
        selectEl.appendChild(option);
      }
    }

    function updateAddon(type) {
      var checkbox = type === "remote" ? remoteCheckbox : caseCheckbox;
      var selectEl = type === "remote" ? remoteSelect : caseSelect;
      var imageEl = type === "remote" ? remoteImage : caseImage;
      var card = root.querySelector('[data-addon-card="' + type + '"]');
      var variant = selectEl ? findAddonVariant(type, selectEl.value) : null;

      if (!variant) return;

      if (imageEl) {
        imageEl.src = cdnResize(variant.image, 100);
        imageEl.alt = "ThePhotoStick " + type + " " + variant.color;
      }

      if (card && checkbox) card.classList.toggle("is-selected", checkbox.checked);
    }

    function loadVideoSource(video) {
      if (video.getAttribute("data-loaded") === "true") return;
      var sources = video.querySelectorAll("source[data-src]");
      var didSet = false;
      for (var s = 0; s < sources.length; s++) {
        var dataSrc = sources[s].getAttribute("data-src");
        if (dataSrc) {
          sources[s].setAttribute("src", dataSrc);
          didSet = true;
        }
      }
      if (didSet) {
        video.setAttribute("data-loaded", "true");
        video.load();
      }
    }

    // Shopify auto-generates a preview frame for CDN videos, reachable via the same
    // hash as the mp4. Returns "" for anything that isn't a Shopify video URL.
    function posterFromVideoUrl(url) {
      if (!url || typeof url !== "string") return "";
      var match = url.match(/\/videos\/c\/o\/v\/([a-z0-9]+)\.mp4/i);
      if (!match) return "";
      // Relative path resolves against the current storefront domain.
      return "/cdn/shop/files/preview_images/" + match[1] + ".thumbnail.0000000000.jpg";
    }

    function applyDerivedPoster(video) {
      // Respect a manually-set poster if one is already present.
      if (video.getAttribute("poster")) return;

      var source = video.querySelector("source[data-src]");
      if (!source) return;

      var posterUrl = posterFromVideoUrl(source.getAttribute("data-src"));
      if (!posterUrl) return;

      // Probe first so a 404 leaves the card as-is instead of flashing a broken image.
      var probe = new Image();
      probe.onload = function () {
        video.setAttribute("poster", cdnResize(posterUrl, 400));
      };
      probe.src = posterUrl;
    }

    function videoOverlayFor(video) {
      var card = video.closest ? video.closest(".tpsc-video-card") : video.parentNode;
      return card ? card.querySelector(".tpsc-video-play") : null;
    }

    // Preview state: muted, looping, autoplays in view, overlay visible.
    function deactivateVideo(video) {
      video.removeAttribute("data-active");
      video.muted = true;
      video.setAttribute("muted", "");
      var overlay = videoOverlayFor(video);
      if (overlay) overlay.classList.remove("is-hidden");
    }

    // Active state: user-initiated, restarts from 0, unmuted, overlay hidden.
    function activateVideo(video) {
      var all = root.querySelectorAll(".tpsc-video-card video");
      for (var i = 0; i < all.length; i++) {
        if (all[i] !== video) deactivateVideo(all[i]);
      }

      loadVideoSource(video);
      video.setAttribute("data-active", "true");
      video.removeAttribute("data-user-paused");
      video.muted = false;

      var overlay = videoOverlayFor(video);
      if (overlay) overlay.classList.add("is-hidden");

      // Only rewind on the first activation — later clicks resume where it left off.
      var isFirstPlay = video.getAttribute("data-started") !== "true";
      video.setAttribute("data-started", "true");

      function startPlayback() {
        if (isFirstPlay) {
          try { video.currentTime = 0; } catch (e) {}
        }
        var p = video.play();
        if (p && typeof p.catch === "function") p.catch(function () {});
      }

      // currentTime can only be set once metadata is available.
      if (video.readyState >= 1) {
        startPlayback();
      } else {
        video.addEventListener("loadedmetadata", startPlayback, { once: true });
      }
    }

    function setupVideoOverlays() {
      var cards = root.querySelectorAll(".tpsc-video-card");
      for (var i = 0; i < cards.length; i++) {
        (function (card) {
          var video = card.querySelector("video");
          var overlay = card.querySelector(".tpsc-video-play");
          if (!video || !overlay) return;

          applyDerivedPoster(video);

          // One handler on the card catches overlay clicks (they bubble) and
          // clicks on the video itself once the overlay is hidden.
          card.addEventListener("click", function () {
            if (video.getAttribute("data-active") === "true") {
              video.pause();
              video.setAttribute("data-user-paused", "true");
              deactivateVideo(video);
            } else {
              activateVideo(video);
            }
          });
        })(cards[i]);
      }
    }

    function prepareVideosForManualPlay() {
      var videos = root.querySelectorAll(".tpsc-video-card video");

      for (var i = 0; i < videos.length; i++) {
        // Muted + playsinline are required for autoplay to be allowed by browsers.
        // Only applied to previews — an active (user-played) video stays unmuted.
        if (videos[i].getAttribute("data-active") !== "true") {
          videos[i].muted = true;
          videos[i].setAttribute("muted", "");
        }
        videos[i].setAttribute("playsinline", "");
      }

      // Fallback: no IntersectionObserver support -> load sources so the play overlay works.
      if (typeof window.IntersectionObserver !== "function") {
        for (var f = 0; f < videos.length; f++) {
          loadVideoSource(videos[f]);
        }
        return;
      }

      var observer = new window.IntersectionObserver(function (entries) {
        for (var e = 0; e < entries.length; e++) {
          var entry = entries[e];
          var video = entry.target;
          if (entry.isIntersecting && entry.intersectionRatio >= 0.5) {
            // Don't override a deliberate pause.
            if (video.getAttribute("data-user-paused") === "true") continue;
            loadVideoSource(video);
            var playPromise = video.play();
            if (playPromise && typeof playPromise.catch === "function") {
              playPromise.catch(function () {});
            }
          } else {
            if (!video.paused) video.pause();
            // Scrolling away drops it back to muted preview so audio never trails offscreen.
            if (video.getAttribute("data-active") === "true") deactivateVideo(video);
            video.removeAttribute("data-user-paused");
          }
        }
      }, { threshold: [0, 0.5, 1] });

      for (var o = 0; o < videos.length; o++) {
        observer.observe(videos[o]);
      }
    }

    function scrollVideoCarousel(direction) {
      if (!videoRow) return;

      var cards = videoRow.querySelectorAll(".tpsc-video-card");
      if (!cards.length) return;

      currentVideoIndex += direction;

      if (currentVideoIndex < 0) {
        currentVideoIndex = cards.length - 1;
      }

      if (currentVideoIndex >= cards.length) {
        currentVideoIndex = 0;
      }

      var targetCard = cards[currentVideoIndex];
      var targetLeft = targetCard.offsetLeft - videoRow.offsetLeft;

      if (typeof videoRow.scrollTo === "function") {
        videoRow.scrollTo({
          left: targetLeft,
          behavior: "smooth"
        });
      } else {
        videoRow.scrollLeft = targetLeft;
      }
    }

    function buildCartUrl() {
      var size = findSize(selectedSizeId);
      var items = [size.variantId + ":1"];
      var remoteVariant = remoteSelect ? findAddonVariant("remote", remoteSelect.value) : null;
      var caseVariant = caseSelect ? findAddonVariant("case", caseSelect.value) : null;

      if (remoteCheckbox && remoteCheckbox.checked && remoteVariant) {
        items.push(remoteVariant.variantId + ":1");
      }

      if (caseCheckbox && caseCheckbox.checked && caseVariant) {
        items.push(caseVariant.variantId + ":1");
      }

      return "/cart/" + items.join(",");
    }

    function goToCheckout() {
      window.location.href = buildCartUrl();
    }

    buildGallery();
    buildSizes();
    buildAddonSelect("remote", remoteSelect);
    buildAddonSelect("case", caseSelect);
    selectSize(selectedSizeId, false);
    setGalleryByIndex(0, true);
    updateAddon("remote");
    updateAddon("case");
    setupVideoOverlays();
    prepareVideosForManualPlay();

    if (prevBtn) {
      prevBtn.addEventListener("click", function () {
        setGalleryByIndex(currentGalleryIndex - 1);
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener("click", function () {
        setGalleryByIndex(currentGalleryIndex + 1);
      });
    }

    // Native scroll-snap handles swiping now; just keep the index/thumbs in sync.
    if (slider) {
      var galleryRafPending = false;
      slider.addEventListener("scroll", function () {
        if (galleryRafPending) return;
        galleryRafPending = true;
        window.requestAnimationFrame(function () {
          galleryRafPending = false;
          syncGalleryIndexFromScroll();
        });
      }, { passive: true });
    }

    function syncVideoIndexFromScroll() {
      if (!videoRow) return;
      var cards = videoRow.querySelectorAll(".tpsc-video-card");
      if (!cards.length) return;

      var closestIndex = 0;
      var closestDistance = Infinity;

      for (var i = 0; i < cards.length; i++) {
        var distance = Math.abs(cards[i].offsetLeft - videoRow.scrollLeft);
        if (distance < closestDistance) {
          closestDistance = distance;
          closestIndex = i;
        }
      }

      currentVideoIndex = closestIndex;
    }

    if (videoRow) {
      videoRow.addEventListener("scroll", function () {
        window.clearTimeout(videoRow._tpscScrollTimer);
        videoRow._tpscScrollTimer = window.setTimeout(syncVideoIndexFromScroll, 80);
      });
    }

    if (videoPrevBtn) {
      videoPrevBtn.addEventListener("click", function () {
        scrollVideoCarousel(-1);
      });
    }

    if (videoNextBtn) {
      videoNextBtn.addEventListener("click", function () {
        scrollVideoCarousel(1);
      });
    }

    if (remoteCheckbox) {
      remoteCheckbox.addEventListener("change", function () {
        updateAddon("remote");
      });
    }

    if (caseCheckbox) {
      caseCheckbox.addEventListener("change", function () {
        updateAddon("case");
      });
    }

    if (remoteSelect) {
      remoteSelect.addEventListener("change", function () {
        updateAddon("remote");
      });
    }

    if (caseSelect) {
      caseSelect.addEventListener("change", function () {
        updateAddon("case");
      });
    }

    if (checkoutBtn) {
      checkoutBtn.addEventListener("click", goToCheckout);
    }
  })();
</script>
    </div>
    </div>
  
    </div>

      
    </gp-row>
  
  
    </div>

      
    </gp-row>
  
        </section>
      
  
    
