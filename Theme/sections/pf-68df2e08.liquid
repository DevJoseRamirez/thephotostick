        }, { passive: true });
      }
    }, 5000);

    yesBtn.addEventListener('click', () => { try { window.location.href = 'https://thephotostick.myshopify.com/cart/42965172682888:1'; } catch (e) { } });
    noBtn.addEventListener('click', e => { e.preventDefault(); popup.style.display = 'none'; });
    yesBtn.addEventListener('mouseover', function () { this.style.backgroundColor = '#45a049'; });
    yesBtn.addEventListener('mouseout', function () { this.style.backgroundColor = '#4CAF50'; });

    function adjustPopupPosition() { if (content) { content.style.top = '50%'; content.style.left = '50%'; content.style.transform = 'translate(-50%,-50%)'; } }
    window.addEventListener('resize', adjustPopupPosition);
