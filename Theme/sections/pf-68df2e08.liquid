(function () {
  if (localStorage.getItem('exitPopupShown')) return;
  function initializePopup() {
    const popup = document.getElementById('exit-popup');
    const content = popup ? popup.querySelector('.popup-content') : null;
    const yesBtn = document.getElementById('yes-button');
    const noBtn = document.getElementById('exit-popup-cross');
    if (!popup || !content || !yesBtn || !noBtn) return;

    const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
    const pageLoadTime = Date.now();
    const DESKTOP_MIN_SESSION_MS = 15000;
    const DESKTOP_MIN_SCROLL_PCT = 30;
    const MOBILE_MIN_SESSION_MS = 15000;
    const MOBILE_MIN_SCROLL_PCT = 50;
    const MOBILE_TOP_ZONE_PX = 80;
    const MOBILE_UP_SWIPE_VELOCITY = -1.2;

    const state = { lastScrollTop: 0, scrollUpStartTime: 0, isScrollingUp: false, popupShown: false, inactivityTimer: null, lastAttemptTs: 0 };

    function scrollPct() {
      const doc = document.documentElement;
      const top = window.scrollY || doc.scrollTop || 0;
      const height = Math.max(doc.scrollHeight, document.body.scrollHeight);
      const view = window.innerHeight;
      const denom = Math.max(1, height - view);
      return Math.round((top / denom) * 100);
    }

    function anyInputFocused() {
      const a = document.activeElement;
      if (!a) return false;
      const tag = (a.tagName || '').toLowerCase();
      return tag === 'input' || tag === 'textarea' || a.isContentEditable;
    }

    function debounce(ms) {
      const now = Date.now();
      if (now - state.lastAttemptTs < ms) return true;
      state.lastAttemptTs = now;
      return false;
    }

    popup.style.cssText = 'display:none;position:fixed;top:0;left:0;width:100%;height:100%;background-color:rgba(0,0,0,0.5);z-index:9999;justify-content:center;align-items:center;';
    content.style.cssText = 'background-color:rgba(255,255,255,0.9);padding:10px 20px 20px;border-radius:10px;text-align:center;max-width:400px;width:90%;position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);';
    yesBtn.style.cssText = 'margin:10px 0;cursor:pointer;font-size:16px;background-color:#4CAF50;color:#fff;border:none;padding:10px 20px;border-radius:5px;text-align:center;text-decoration:none;display:inline-block;transition:background-color .3s;';
    noBtn.style.cssText = 'margin:10px 0;cursor:pointer;font-size:16px;text-decoration:underline;background:none;border:none;padding:0;color:#2196F3;display:block;';

    function showPopup() {
      if (state.popupShown) return;
      popup.style.display = 'flex';
      localStorage.setItem('exitPopupShown', 'true');
      state.popupShown = true;
      if (isMobile) {
        window.removeEventListener('scroll', checkScroll);
        clearTimeout(state.inactivityTimer);
      }
    }

    function checkScroll() {
      const st = window.pageYOffset || document.documentElement.scrollTop;
      const currentTime = Date.now();
      const rapidScrollThreshold = 50;
      if (st < state.lastScrollTop) {
        const scrollSpeed = (state.lastScrollTop - st) / (currentTime - (state.isScrollingUp ? state.scrollUpStartTime : currentTime)) * 100;
        if (!state.isScrollingUp) {
          state.isScrollingUp = true;
          state.scrollUpStartTime = currentTime;
        } else if ((scrollSpeed > rapidScrollThreshold && currentTime - state.scrollUpStartTime > 1000) || st === 0) {
          if (shouldShowMobile()) showPopup();
        }
      } else {
        state.isScrollingUp = false;
      }
      state.lastScrollTop = st <= 0 ? 0 : st;
      resetInactivityTimer();
    }

    function resetInactivityTimer() {
      clearTimeout(state.inactivityTimer);
      state.inactivityTimer = setTimeout(() => { if (isMobile && shouldShowMobile()) showPopup(); }, 12000);
    }

    function hasMinSession(ms) { return Date.now() - pageLoadTime >= ms; }
    function isNearTop(px) { return (window.scrollY || document.documentElement.scrollTop || 0) <= px; }
    function shouldShowMobile() {
      if (!hasMinSession(MOBILE_MIN_SESSION_MS)) return false;
      if (scrollPct() < MOBILE_MIN_SCROLL_PCT) return false;
      if (!isNearTop(MOBILE_TOP_ZONE_PX)) return false;
      if (anyInputFocused()) return false;
      return true;
    }
    function shouldShowDesktop() {
      if (!hasMinSession(DESKTOP_MIN_SESSION_MS)) return false;
      if (scrollPct() < DESKTOP_MIN_SCROLL_PCT) return false;
      if (anyInputFocused()) return false;
      return true;
    }

    setTimeout(() => {
      if (isMobile) {
        window.addEventListener('scroll', checkScroll, { passive: true });
        resetInactivityTimer();
        ['touchstart', 'touchmove', 'keydown'].forEach(evt => { document.addEventListener(evt, resetInactivityTimer, { passive: true }); });
        window.addEventListener('popstate', e => { e.preventDefault(); if (shouldShowMobile() && !debounce(1000)) showPopup(); });
        try { window.history.pushState(null, '', window.location.href); } catch (e) { }
      } else {
