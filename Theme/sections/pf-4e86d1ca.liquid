          thumbBtn.className = "tps-thumb";
          thumbBtn.setAttribute("data-image-id", image.id);
          thumbBtn.setAttribute("aria-label", image.alt || "View product image");

          thumbBtn.innerHTML =
            '<img src="' + image.thumb + '" alt="' + (image.alt || "Product image") + '">';

          thumbBtn.addEventListener("click", function () {
            setMainImageByIndex(index);
          });

          thumbsWrap.appendChild(thumbBtn);
        })(offerConfig.galleryImages[i], i);
      }
    }

    function goToCheckout() {
      var selectedOffer = findOffer(selectedId);

      if (!selectedOffer || !selectedOffer.checkoutUrl) return;

      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: "axon_dynamic_add_to_cart",
        selected_offer_id: selectedOffer.id,
        selected_offer_title: selectedOffer.title,
        selected_offer_price: selectedOffer.salePrice,
        selected_offer_compare_price: selectedOffer.comparePrice,
        axon_buy_class: selectedOffer.axonBuyClass || ""
      });

      window.setTimeout(function () {
        window.location.href = selectedOffer.checkoutUrl;
      }, 200);
    }

    buildOffers();
    buildThumbs();

    /*
      Load the default selected offer image first.
      Since defaultSelectedId is 64gb, the 64GB product image will show first.
      If the customer clicks another offer block, the main image swaps to that product image.
    */
    setMainImageByIndex(findGalleryIndexById(selectedId));
    updateDynamicAxonBuyClass(findOffer(selectedId));

    if (checkoutBtn) {
      checkoutBtn.addEventListener("click", goToCheckout);
    }

    if (prevBtn) {
      prevBtn.addEventListener("click", function () {
        setMainImageByIndex(currentGalleryIndex - 1);
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener("click", function () {
        setMainImageByIndex(currentGalleryIndex + 1);
      });
    }
  })();
</script></div></div></div></div></div></div><div style="--overlay:rgba(255, 255, 255, 0.9)" data-section-id="pf-59d8" data-pf-type="Section" class="sc-gplwNw kNhQlQ pf-304_ pf-color-scheme-1 pf-bg-lazy"><div class="sc-cTTcKX csqrLN"></div><div style="--cw:1170px" class="sc-jlGhtx hdJeUI"><div class="sc-fBWQee eTKFIf pf-305_ pf-r pf-r-eh" style="--s-xs:0px;--s-sm:15px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-fPrdjK cvZVBM pf-306_"><p class="sc-lfYA-dV cHEUzQ pf-307_ pf-text-1" data-pf-type="Paragraph"><span data-pf-type="Text" class="sc-cHMHbD bwTmDt pf-309_">{{ section.settings.pf_d8d2e1cd_value }}</span></p><h3 data-pf-type="Heading" class="sc-eNSrbD dsyRF pf-310_ pf-heading-1-h3"><span data-pf-type="Text" class="sc-cHMHbD bwTmDt pf-312_">{{ section.settings.pf_cd1fa87d_value }}</span></h3></div></div></div><div class="sc-fBWQee eTKFIf pf-313_ pf-r pf-r-eh" style="--s-xs:10px;--s-sm:13px;--s-md:5px;--s-lg:7px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:6;--c-md:3;--c-lg:3"><div data-pf-type="Column" class="sc-fPrdjK cvZVBM pf-314_ animate-grow"><h3 data-pf-type="Heading" class="sc-eNSrbD dsyRF pf-315_ pf-heading-1-h3"><span data-pf-type="Text" class="sc-cHMHbD bwTmDt pf-317_">{{ section.settings.pf_24a6fab5_value }}</span></h3><div data-pf-type="Image" class="sc-bJBfJu eIhGFX pf-318_ pf-image-1"><img src="https://cdn.shopify.com/s/files/1/1681/4029/files/TPSO_X_11_1200x.png?v=1774308986" srcSet="https://cdn.shopify.com/s/files/1/1681/4029/files/TPSO_X_11.png?v=1774308986 1536w" width="2160" height="2160" sizes="(min-width: 1536px) 1536px, (min-width: 1024px) 1280px, (min-width: 640px) 768px, calc(100vw/3)" loading="lazy" alt="TPSO X (11).png__PID:10d1b970-4fe4-4230-a391-b983e88400f5"/></div><p class="sc-lfYA-dV cHEUzQ pf-319_ pf-text-1" data-pf-type="Paragraph"><span data-pf-type="Text" class="sc-cHMHbD bwTmDt pf-321_">{{ section.