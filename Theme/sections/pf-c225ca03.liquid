    </script><script src="https://cdn.pagefly.io/pagefly/4.18.4/core/helper.js" defer></script><script>(function () {
  if (localStorage.getItem('exitPopupShown')) return;

  var popup = document.getElementById('exit-popup');
  var content = popup.querySelector('.popup-content');
  var yesBtn = document.getElementById('yes-button');
  var noBtn = document.getElementById('exit-popup-cross');

  var isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);

  // Styling
  popup.style.cssText = 'display:none; position:fixed; top:0; left:0; width:100%; height:100%; background-color:rgba(0,0,0,0.5); z-index:9999; justify-content:center; align-items:center;';
  content.style.cssText = 'background-color:rgba(255,255,255,0.9); padding:10px 20px 20px; border-radius:10px; text-align:center; max-width:400px; width:90%; position:absolute; top:50%; left:50%; transform:translate(-50%, -50%);';
  yesBtn.style.cssText = 'margin:10px 0; cursor:pointer; font-size:16px; background-color:#4CAF50; color:white; border:none; padding:10px 20px; border-radius:5px; text-align:center; text-decoration:none; display:inline-block; transition:background-color 0.3s;';
  noBtn.style.cssText = 'margin:10px 0; cursor:pointer; font-size:16px; text-decoration:underline; background:none; border:none; padding:0; color:#2196F3; display:block;';

  var pageLoadTime = Date.now();
  var lastScrollTop = 0;
  var scrollUpStartTime = 0;
  var isScrollingUp = false;
  var rapidScrollThreshold = 50; // pixels per 100ms
  var popupShown = false;
  var inactivityTimer;

  function showPopup() {
    if (!popupShown) {
      console.log("Showing popup");
      popup.style.display = 'flex';
      localStorage.setItem('exitPopupShown', 'true');
      popupShown = true;
      if (isMobile) {
        window.removeEventListener('scroll', checkScroll);
        clearTimeout(inactivityTimer);
      }
    }
  }

  function checkScroll() {
    var st = window.pageYOffset || document.documentElement.scrollTop;
    var currentTime = Date.now();

    if (st < lastScrollTop) {
      // Scrolling up
      var scrollSpeed = (lastScrollTop - st) / (currentTime - (isScrollingUp ? scrollUpStartTime : currentTime)) * 100;
      if (!isScrollingUp) {
        isScrollingUp = true;
        scrollUpStartTime = currentTime;
      } else if ((scrollSpeed > rapidScrollThreshold && currentTime - scrollUpStartTime > 1000) || st === 0) {
        // If scrolling up rapidly for more than 1 second or reached the top of the page
        showPopup();
      }
    } else {
      isScrollingUp = false;
    }

    lastScrollTop = st <= 0 ? 0 : st;
    resetInactivityTimer();
  }

  function resetInactivityTimer() {
    clearTimeout(inactivityTimer);
    inactivityTimer = setTimeout(showPopup, 12000); // 12 seconds of inactivity
  }

  function handleBackButton(e) {
    e.preventDefault();
    showPopup();
  }

  setTimeout(function () {
    console.log("Setting up exit intent. Is Mobile:", isMobile);
    if (isMobile) {
      window.addEventListener('scroll', checkScroll, { passive: true });
      resetInactivityTimer();
      ['touchstart', 'touchmove', 'keydown'].forEach(function (evt) {
        document.addEventListener(evt, resetInactivityTimer, { passive: true });
      });
      window.addEventListener('popstate', handleBackButton);
      window.history.pushState(null, '', window.location.href);
    } else {
      // Desktop exit intent
      document.addEventListener('mouseleave', function (e) {
        console.log("Mouse left the window. ClientY:", e.clientY);
        if (e.clientY < 0 && Date.now() - pageLoadTime > 5000) {
          showPopup();
        }
      });
    }
  }, 5000);

  // Button click handlers
  yesBtn.addEventListener('click', function () {
    window.location.href = 'https://thephotostick.myshopify.com/cart/42965172682888:1';
  });

  noBtn.addEventListener('click', function (e) {
    e.preventDefault();
    popup.style.display = 'none';
  });

  // Add hover effect
  yesBtn.addEventListener('mouseover', function () {
    this.style.backgroundColor = '#45a049';
  });
  yesBtn.addEventListener('mouseout', function () {
    this.style.backgroundColor = '#4CAF50';
  });

  // Ensure popup stays centered
  function adjustPopupPosition() {
    content.style.top = '50%';
    content.style.left = '50%';
    content.style.transform = 'translate(-50%, -50%)';
  }

  window.addEventListener('resize', adjustPopupPosition);
  window.addEventListener('orientationchange', adjustPopupPosition);

  // Add media query for mobile
  var mobileStyle = document.createElement('style');
  mobileStyle.textContent = `
    @media (max-width: 480px) {
      #exit-popup .popup-content { 
        width: 95%; 
        max-height: 90vh;
        overflow-y: auto;
      }
      #exit-popup #yes-button { font-size: 14px; padding: 8px 16px; }
      #exit-popup #exit-popup-cross { font-size: 14px; }
    }
  `;
  document.head.appendChild(mobileStyle);

  console.log("Exit intent script loaded");
})();</script>
