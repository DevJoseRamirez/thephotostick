<style>
  :root {
    --omni-z: 999999;
    --omni-backdrop: rgba(0, 0, 0, .6);
    --omni-dialog: #fff;
    --omni-text: #222;
    --omni-sub: #555;
    --omni-accent: #FFC627;
    --omni-accent-text: #111;
    --omni-link: #2a7ae2;
    --omni-border: rgba(0, 0, 0, .15)
  }

  body.omni-lock {
    overflow: hidden !important
  }

  /* Container */
  .omni-popup.is-hidden {
    display: none !important
  }

  #omni-offer-popup {
    position: fixed;
    inset: 0;
    z-index: var(--omni-z);
    display: grid;
    place-items: center;
    font-family: system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial, sans-serif;
    color: var(--omni-text)
  }

  .omni-popup__backdrop {
    position: absolute;
    inset: 0;
    background: var(--omni-backdrop)
  }

  .omni-popup__dialog {
    position: relative;
    max-width: 980px;
    width: min(96vw, 980px);
    background: var(--omni-dialog);
    border: 4px solid var(--omni-border);
    box-shadow: 0 30px 80px rgba(0, 0, 0, .35);
    border-radius: 6px;
    overflow: hidden
  }

  .omni-popup__close {
    position: absolute;
    top: 10px;
    right: 12px;
    width: 40px;
    height: 40px;
    border: 0;
    background: transparent;
    font-size: 30px;
    line-height: 1;
    color: #888;
    cursor: pointer;
    z-index: 2;
    display: grid;
    place-items: center
  }

  .omni-popup__close:hover {
    color: #000
  }

  /* Layout */
  .omni-popup__inner {
    display: grid;
    grid-template-columns: 360px 1fr;
    gap: 28px;
    align-items: center;
    padding: 32px 36px
  }

  .omni-popup__left {
    display: grid;
    align-items: center;
    justify-items: center;
    padding: 8px 0
  }

  .omni-popup__left img {
    max-width: 100%;
    height: auto;
    object-fit: contain
  }

  .omni-popup__right {
    padding-right: 8px
  }

  /* Typography */
  .omni-popup__eyebrow {
    text-align: center;
    font-size: 16px;
    color: var(--omni-sub);
    margin-bottom: 6px
  }

  .omni-popup__headline {
    display: flex;
    align-items: baseline;
    justify-content: center;
    gap: 10px;
    margin-bottom: 8px
  }

  .omni-popup__headline-big {
    font-size: clamp(56px, 9vw, 120px);
    font-weight: 800;
    letter-spacing: -2px
  }

  .omni-popup__headline-rest {
    font-size: clamp(26px, 3.2vw, 44px);
    font-weight: 700
  }

  .omni-popup__kicker {
    text-align: center;
    font-size: clamp(16px, 2.2vw, 22px);
    margin: 8px 0 4px
  }

  .omni-popup__kicker strong {
    font-weight: 800
  }

  .omni-popup__title {
    text-align: center;
    font-size: clamp(18px, 2.4vw, 26px);
    font-weight: 800;
    color: #e86e00;
    letter-spacing: .2px;
    margin-bottom: 10px
  }

  .omni-popup__pricing {
    text-align: center;
    font-size: clamp(14px, 2vw, 18px);
    margin-bottom: 18px;
    color: var(--omni-sub)
  }

  .omni-popup__strike {
    text-decoration: line-through;
    color: #c34a3a;
    margin-right: 12px;
    display: inline-block
  }

  .omni-popup__price {
    color: var(--omni-text);
    font-weight: 600
  }

  .omni-popup__cta {
    display: grid;
    gap: 12px;
    justify-items: center
  }

  .omni-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 8px;
    text-decoration: none;
    cursor: pointer;
    transition: transform .05s ease, filter .2s ease;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    pointer-events: auto !important
  }

  .omni-btn--primary {
    min-width: 320px;
    padding: 14px 20px;
    font-size: clamp(16px, 2.2vw, 20px);
    font-weight: 800;
    background: var(--omni-accent);
    color: var(--omni-accent-text);
    box-shadow: inset 0 -2px 0 rgba(0, 0, 0, .2), 0 6px 18px rgba(0, 0, 0, .15)
  }

  .omni-btn--primary:hover {
    filter: brightness(.98)
  }

  .omni-btn--primary:active {
    transform: translateY(1px)
  }

  .omni-btn--link {
    background: transparent;
    padding: 6px 8px;
    border-radius: 4px;
    color: var(--omni-link);
    font-size: 15px;
    font-weight: 600
  }

  .omni-btn--link:hover {
    text-decoration: underline
  }

  /* Mobile */
  @media (max-width:900px) {
    .omni-popup__inner {
      grid-template-columns: 1fr;
      padding: 20px;
      gap: 14px
    }

    .omni-popup__left {
      order: 1
    }

    .omni-popup__right {
      order: 2;
      padding-right: 0
    }

    .omni-popup__headline {
      margin-bottom: 4px
    }

    .omni-popup__kicker {
      margin: 6px 0 2px
    }

    .omni-popup__title {
      margin-bottom: 8px
    }

    .omni-popup__pricing {
      margin-bottom: 14px
    }

    .omni-btn--primary {
      min-width: 240px;
      padding: 12px 18px
    }
  }

  /* ===== Trigger clickability override (PageFly) ===== */
  #button-1,
  #button-2,
  #button-3,
  #button-4,
  #button-5,
  #button-6,
  #button-7,
  #button-8,
  .pf-btn#button-1,
  .pf-btn#button-2,
  .pf-btn#button-3,
  .pf-btn#button-4,
  .pf-btn#button-5,
  .pf-btn#button-6,
  .pf-btn#button-7,
  .pf-btn#button-8 {
    pointer-events: auto !important;
    cursor: pointer !important;
  }
</style>

