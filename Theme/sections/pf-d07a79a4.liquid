    var remoteCheckbox = root.querySelector("#tpsRemoteCheckbox");
    var remoteAddonCard = root.querySelector("#tpsRemoteAddonCard");

    var selectedId = offerConfig.defaultSelectedId || offerConfig.offers[0].id;
    var currentGalleryIndex = 0;

    function findOffer(id) {
      for (var i = 0; i < offerConfig.offers.length; i++) {
        if (offerConfig.offers[i].id === id) {
          return offerConfig.offers[i];
        }
      }
      return offerConfig.offers[0];
    }

    function findByColor(items, color) {
      for (var i = 0; i < items.length; i++) {
        if (items[i].color === color) {
          return items[i];
        }
      }

      return items[0];
    }

    function getVariantIdFromCheckoutUrl(url) {
      var match = String(url || "").match(/\/cart\/(\d+):/);
      return match ? match[1] : "";
    }

    function buildMultiItemCartUrl(items) {
      return "https://thephotostick.com/cart/" + items.map(function (item) {
        return item.variantId + ":" + (item.quantity || 1);
      }).join(",");
    }

    function findGalleryIndexById(id) {
      for (var i = 0; i < offerConfig.galleryImages.length; i++) {
        if (offerConfig.galleryImages[i].id === id) {
          return i;
        }
      }
      return 0;
    }

    function updateThumbActiveState(activeImageId) {
      var thumbs = root.querySelectorAll(".tps-thumb");

      for (var i = 0; i < thumbs.length; i++) {
        thumbs[i].classList.toggle(
          "is-active",
          thumbs[i].getAttribute("data-image-id") === activeImageId
        );
      }
    }

    function setMainImageByIndex(index) {
      if (!offerConfig.galleryImages.length || !mainImage) return;

      if (index < 0) index = offerConfig.galleryImages.length - 1;
      if (index >= offerConfig.galleryImages.length) index = 0;

      currentGalleryIndex = index;

      var image = offerConfig.galleryImages[currentGalleryIndex];

      mainImage.style.opacity = "0";

      window.setTimeout(function () {
        mainImage.src = image.src;
        mainImage.alt = image.alt || "ThePhotoStick Omni";
        mainImage.style.opacity = "1";
      }, 100);

      updateThumbActiveState(image.id);
    }

    function selectOffer(id) {
      selectedId = id;

      var cards = root.querySelectorAll(".tps-offer-card");

      for (var i = 0; i < cards.length; i++) {
        cards[i].classList.toggle(
          "is-selected",
          cards[i].getAttribute("data-offer-id") === selectedId
        );
      }

      setMainImageByIndex(findGalleryIndexById(selectedId));
      updateBundleFromSelectedOffer();
    }

    function buildOffers() {
      if (!offerList) return;

      offerList.innerHTML = "";

      for (var i = 0; i < offerConfig.offers.length; i++) {
        (function (offer) {
          var card = document.createElement("button");
          card.type = "button";
          card.className = "tps-offer-card";
          card.setAttribute("data-offer-id", offer.id);
          card.setAttribute("aria-label", "Select " + offer.title);

          if (offer.id === selectedId) {
            card.classList.add("is-selected");
          }

          var cornerBadgeHtml = offer.cornerBadge
            ? '<div class="tps-corner-badge">' + offer.cornerBadge + "</div>"
            : "";

          card.innerHTML =
            cornerBadgeHtml +
            '<div class="tps-offer-img-wrap">' +
              '<img class="tps-offer-img" src="' + offer.productImage + '" alt="' + offer.title + '">' +
            '</div>' +
            '<div class="tps-offer-copy">' +
              '<div class="tps-offer-title-row">' +
                '<div class="tps-offer-title">' + offer.title + '</div>' +
                '<div class="tps-discount-badge">' + offer.discount + '</div>' +
              '</div>' +
              '<div class="tps-offer-subtitle">' + offer.subtitle + '</div>' +
            '</div>' +
            '<div class="tps-price-wrap">' +
              '<div class="tps-sale-price">' + offer.salePrice + '</div>' +
              '<div class="tps-compare-price">' + offer.comparePrice + '</div>' +
            '</div>';

          card.addEventListener("click", function () {
            selectOffer(offer.id);
          });

          offerList.appendChild(card);
        })(offerConfig.offers[i]);
      }
    }

    function buildThumbs() {
      if (!thumbsWrap) return;

      thumbsWrap.innerHTML = "";

      for (var i = 0; i < offerConfig.galleryImages.length; i++) {
        (function (image, index) {
          var thumbBtn = document.createElement("button");
          thumbBtn.type = "button";
          thumbBtn.className = "tps-thumb";
          thumbBtn.setAttribute("data-image-id", image.id);
          thumbBtn.setAttribute("aria-label", image.alt || "View product image");

          thumbBtn.innerHTML =
            '<img src="' + image.thumb + '" alt="' + (image.alt || "Product image") + '">';

          thumbBtn.addEventListener("click", function () {
            setMainImageByIndex(index);
          });

          thumbsWrap.appendChild(thumbBtn);
        })(offerConfig.galleryImages[i], i);
      }
    }


    function populateSelect(select, items, valueKey, labelKey) {
      if (!select) return;

      select.innerHTML = "";

      for (var i = 0; i < items.length; i++) {
        var option = document.createElement("option");
        option.value = items[i][valueKey];
        option.textContent = items[i][labelKey];
        select.appendChild(option);
      }

      if (items.length) {
        select.value = items[0][valueKey];
      }
    }

    function buildBundleControls() {
      if (bundleOmniSelect) {
        bundleOmniSelect.innerHTML = "";

        for (var i = 0; i < offerConfig.offers.length; i++) {
          var offer = offerConfig.offers[i];
          var option = document.createElement("option");
          option.value = offer.id;
          option.textContent = offer.title;
          bundleOmniSelect.appendChild(option);
        }

        bundleOmniSelect.addEventListener("change", function () {
          selectOffer(bundleOmniSelect.value);
        });
      }

      populateSelect(caseColorSelect, offerConfig.bundleConfig.caseOptions, "color", "color");
      populateSelect(remoteColorSelect, offerConfig.bundleConfig.remoteOptions, "color", "color");

      /* Reset browser/autofill-retained dropdown values so the bundle loads predictably. */
      if (caseColorSelect) {
        caseColorSelect.value = "Black";
      }

      if (remoteColorSelect) {
        remoteColorSelect.value = "Black";
      }

      if (remoteCheckbox) {
        remoteCheckbox.checked = false;
      }

      if (caseColorSelect) {
        caseColorSelect.addEventListener("change", updateCaseBundleItem);
      }

      if (remoteColorSelect) {
        remoteColorSelect.addEventListener("change", updateRemoteBundleItem);
      }

      if (remoteCheckbox) {
        remoteCheckbox.addEventListener("change", function () {
          if (remoteAddonCard) {
            remoteAddonCard.classList.toggle("is-selected", remoteCheckbox.checked);
          }
        });
      }

      updateBundleFromSelectedOffer();
      updateCaseBundleItem();
      updateRemoteBundleItem();
    }

    function updateBundleFromSelectedOffer() {
      if (!bundleOmniSelect) return;

      var selectedOffer = findOffer(selectedId);
      var bundlePrice = offerConfig.bundleConfig.omniBundlePrices[selectedOffer.id] || offerConfig.bundleConfig.omniBundlePrices["64gb"];

      bundleOmniSelect.value = selectedOffer.id;

      var omniImage = root.querySelector("#tpsBundleOmniImage");
      var omniTitle = root.querySelector("#tpsBundleOmniTitle");
      var omniPrice = root.querySelector("#tpsBundleOmniPrice");
      var omniCompare = root.querySelector("#tpsBundleOmniCompare");
      var bundleTotalPrice = root.querySelector("#tpsBundleTotalPrice");
      var bundleComparePrice = root.querySelector("#tpsBundleComparePrice");
      var bundleSavings = root.querySelector("#tpsBundleSavings");

      if (omniImage) {
        omniImage.src = selectedOffer.productImage;
        omniImage.alt = "ThePhotoStick Omni " + selectedOffer.title;
      }

      if (omniTitle) {
        omniTitle.textContent = "ThePhotoStick® Omni " + selectedOffer.title;
      }

      if (omniPrice) {
        omniPrice.textContent = selectedOffer.salePrice;
      }

      if (omniCompare) {
        omniCompare.textContent = selectedOffer.comparePrice;
      }

      if (bundleTotalPrice) {
        bundleTotalPrice.textContent = bundlePrice.totalPrice;
      }

      if (bundleComparePrice) {
        bundleComparePrice.textContent = bundlePrice.comparePrice;
      }

      if (bundleSavings) {
        bundleSavings.textContent = bundlePrice.savings;
      }
    }

    function updateCaseBundleItem() {
      if (!caseColorSelect) return;

      var selectedCase = findByColor(offerConfig.bundleConfig.caseOptions, caseColorSelect.value);
      var caseImage = root.querySelector("#tpsCaseImage");
      var casePrice = root.querySelector("#tpsCasePrice");
      var caseCompare = root.querySelector("#tpsCaseCompare");

      if (caseImage) {
        caseImage.src = selectedCase.image;
        caseImage.alt = "ThePhotoStick Travel Tech Case " + selectedCase.color;
      }

      if (casePrice) {
        casePrice.textContent = selectedCase.price;
      }

      if (caseCompare) {
        caseCompare.textContent = selectedCase.comparePrice;
      }
    }

    function updateRemoteBundleItem() {
      if (!remoteColorSelect) return;

      var selectedRemote = findByColor(offerConfig.bundleConfig.remoteOptions, remoteColorSelect.value);
      var remoteImage = root.querySelector("#tpsRemoteImage");
      var remotePrice = root.querySelector("#tpsRemotePrice");
      var remoteCompare = root.querySelector("#tpsRemoteCompare");
      var remoteSavings = root.querySelector("#tpsRemoteSavings");

      if (remoteImage) {
        remoteImage.src = selectedRemote.image;
        remoteImage.alt = "ThePhotoStick Quick Click Remote " + selectedRemote.color;
      }

      if (remotePrice) {
        remotePrice.textContent = selectedRemote.price;
      }

      if (remoteCompare) {
        remoteCompare.textContent = selectedRemote.comparePrice;
      }

      if (remoteSavings) {
        remoteSavings.textContent = selectedRemote.savings;
      }
    }

    function goToBundleCheckout() {
      var selectedOffer = findOffer(bundleOmniSelect ? bundleOmniSelect.value : selectedId);
      var omniVariantId = getVariantIdFromCheckoutUrl(selectedOffer.checkoutUrl);
      var selectedCase = findByColor(offerConfig.bundleConfig.caseOptions, caseColorSelect ? caseColorSelect.value : "Black");
      var selectedRemote = findByColor(offerConfig.bundleConfig.remoteOptions, remoteColorSelect ? remoteColorSelect.value : "Black");

      if (!omniVariantId || !selectedCase || !selectedCase.variantId) return;

      var items = [
        { variantId: omniVariantId, quantity: 1 },
        { variantId: selectedCase.variantId, quantity: 1 }
      ];

      if (remoteCheckbox && remoteCheckbox.checked && selectedRemote && selectedRemote.variantId) {
        items.push({ variantId: selectedRemote.variantId, quantity: 1 });
      }

      window.location.href = buildMultiItemCartUrl(items);
    }

    function goToCheckout() {
      var selectedOffer = findOffer(selectedId);

      if (!selectedOffer || !selectedOffer.checkoutUrl) return;

      window.location.href = selectedOffer.checkoutUrl;
    }

    buildOffers();
    buildThumbs();
    buildBundleControls();
    setMainImageByIndex(findGalleryIndexById(selectedId));

    if (checkoutBtn) {
      checkoutBtn.addEventListener("click", goToCheckout);
    }

    if (bundleCheckoutBtn) {
      bundleCheckoutBtn.addEventListener("click", goToBundleCheckout);
    }

    if (prevBtn) {
      prevBtn.addEventListener("click", function () {
        setMainImageByIndex(currentGalleryIndex - 1);
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener("click", function () {
        setMainImageByIndex(currentGalleryIndex + 1);
      });
    }
  })();
</script></div></div></div></div></div></div><div data-section-id="pf-a70a" data-pf-type="Section" class="sc-pKreJ kztRcD pf-62_ pf-color-scheme-1"><div style="--cw:1170px" class="sc-djTQOc ejtSSi"><div class="sc-bmzXxz iAfMPC pf-63_ pf-r pf-r-eh" style="--s-xs:15px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-fscnvs bOiGIg pf-64_"><div class="sc-bmzXxz iAfMPC pf-65_ pf-r pf-r-eh" style="--s-xs:15px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:6;--c-lg:6"><div data-pf-type="Column" class="sc-fscnvs bOiGIg pf-66_"><h3 data-pf-type="Heading" class="sc-dJjagV faqBYR pf-67_ pf-heading-1-h3"><span data-pf-type="Text" class="sc-gwZLmR bKBQrY pf-69_">{{ section.settings.pf_3a8dd411_value }}</span></h3><ul style="--pf-line-spacing-xs:92px;--pf-line-spacing-sm:92px;--pf-line-spacing-md:92px;--pf-line-spacing-lg:92px;--pf-text-indent-xs:0px;--pf-text-indent-sm:0px;--pf-text-indent-md:0px;--pf-text-indent-lg:0px" data-pf-type="List2" class="sc-djVWQC gSkqPQ pf-70_"><li data-pf-type="List2.Item2" class="sc-epRwmx foIZBL pf-71_ pf-text-1"><i class="sc-kgOKhb fDsHtk pf-72_ pf-icon-1 pfa pfa-star" data-pf-type="Icon"></i>{{ section.settings.pf_63bd8f35_value }}</li><li data-pf-type="List2.Item2" class="sc-epRwmx foIZBL pf-73_ pf-text-1"><i class="sc-kgOKhb fDsHtk pf-74_ pf-icon-1 pfa pfa-star" data-pf-type="Icon"></i>{{ section.settings.pf_b1068976_value }}</li><li data-pf-type="List2.Item2" class="sc-epRwmx foIZBL pf-75_ pf-text-1"><i class="sc-kgOKhb fDsHtk pf-76_ pf-icon-1 pfa pfa-star" data-pf-type="Icon"></i>{{ section.settings.pf_42dcf7c2_value }}</li><li data-pf-type="List2.Item2" class="sc-epRwmx foIZBL pf-77_ pf-text-1"><i class="sc-kgOKhb fDsHtk pf-78_ pf-icon-1 pfa pfa-star" data-pf-type="Icon"></i>{{ section.settings.pf_5a4a395c_value }}</li><li data-pf-type="List2.Item2" class="sc-epRwmx foIZBL pf-79_ pf-text-1"><i class="sc-kgOK