  function initExitPopup() {
    var popup = document.getElementById('exit-popup');

    if (!popup) {
      console.error("Exit popup not found: #exit-popup does not exist on the page.");
      return;
    }

    var content = popup.querySelector('.popup-content');
    var yesBtn = document.getElementById('yes-button');
    var noBtn = document.getElementById('exit-popup-cross');

    if (!content || !yesBtn || !noBtn) {
