      font-size: 16px;
      font-weight: 700;
      background-color: #4CAF50;
      color: white;
      border: none;
      padding: 12px 20px;
      border-radius: 6px;
      text-align: center;
      display: inline-block;
      width: 100%;
      max-width: 320px;
    `;

    noBtn.style.cssText = `
      margin: 8px 0 0;
      cursor: pointer;
      font-size: 14px;
      text-decoration: underline;
      background: none;
      border: none;
      padding: 0;
      color: #2196F3;
      display: block;
    `;

    function showPopup(reason) {
      if (popupShown) return;

      console.log("Showing exit popup. Reason:", reason);
      popup.style.display = 'flex';
