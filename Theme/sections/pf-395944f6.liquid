innerHTML = Math.floor(distance / (day)),\n    document.getElementById(\"abar-hours\").innerHTML = Math.floor((distance % (day)) / (hour)),\n    document.getElementById(\"abar-minutes\").innerHTML = Math.floor((distance % (hour)) / (minute)),\n    document.getElementById(\"abar-seconds\").innerHTML = Math.floor((distance % (minute)) / second)\n    \n    //reset countdown timer to be 3hours, 12min, 46seconds ahead when limit reached\n    if (distance < 0) {\n      // eventFullDate = new Date()\n      // eventFullDate.setHours(eventFullDate.getHours() + 0),\n      // eventFullDate.setMinutes(eventFullDate.getMinutes() + 0),\n      // eventFullDate.setSeconds(eventFullDate.getSeconds() + 10)\n      countdown = new Date()\n      countdown.setHours(countdown.getHours() + 3),\n      countdown.setMinutes(countdown.getMinutes() + 12),\n      countdown.setSeconds(countdown.getSeconds() + 46)\n      window.localStorage.setItem(\"time\", countdown)\n      countdown = countdown.getTime()\n      // alert(countdown)\n      // clearInterval(x)\n    }\n  }, 0)\n}())\n</script>"
