          thumbBtn.setAttribute("aria-label", image.alt || "View product image");

          thumbBtn.innerHTML =
            '<img src="' + image.thumb + '" alt="' + (image.alt || "Product image") + '">';

          thumbBtn.addEventListener("click", function () {
            setMainImageByIndex(index);
          });

          thumbsWrap.appendChild(thumbBtn);
        })(offerConfig.galleryImages[i], i);
      }
    }

    function goToCheckout() {
      var selectedOffer = findOffer(selectedId);

      if (!selectedOffer || !selectedOffer.checkoutUrl) return;

      /*
        Axon/AppLovin note:
        We intentionally do not push a manual add_to_cart event here.
        Redirecting to the Shopify cart/checkout URL lets Shopify/Axon's native checkout
        tracking capture the add_to_cart and begin_checkout events with the selected
        marketing-product variant. The axon-dyn-buy-* classes remain for debugging
        and future GTM use, but no custom add_to_cart pixel is fired from this block.
      */
      window.location.href = selectedOffer.checkoutUrl;
    }

    buildOffers();
    buildThumbs();

    /*
      Load the default selected offer image first.
      Since defaultSelectedId is 64gb, the 64GB product image will show first.
      If the customer clicks another offer block, the main image swaps to that product image.
    */
    setMainImageByIndex(findGalleryIndexById(selectedId));
    updateDynamicAxonBuyClass(findOffer(selectedId));

    if (checkoutBtn) {
      checkoutBtn.addEventListener("click", goToCheckout);
    }

    if (prevBtn) {
      prevBtn.addEventListener("click", function () {
        setMainImageByIndex(currentGalleryIndex - 1);
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener("click", function () {
        setMainImageByIndex(currentGalleryIndex + 1);
      });
    }
  })();
</script></div></div></div></div></div></div><div style="--overlay:rgba(255, 255, 255, 0.9)" data-section-id="pf-b2c8" data-pf-type="Section" class="sc-gplwNw kNhQlQ pf-302_ pf-color-scheme-1 pf-bg-lazy"><div class="sc-cTTcKX csqrLN"></div><div style="--cw:1170px" class="sc-jlGhtx hdJeUI"><div class="sc-fBWQee eTKFIf pf-303_ pf-r pf-r-eh" style="--s-xs:0px;--s-sm:15px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-fPrdjK cvZVBM pf-304_"><p class="sc-lfYA-dV cHEUzQ pf-305_ pf-text-1" data-pf-type="Paragraph"><span data-pf-type="Text" class="sc-cHMHbD bwTmDt pf-307_">{{ section.settings.pf_c87fab0e_value }}</span></p><h3 data-pf-type="Heading" class="sc-eNSrbD dsyRF pf-308_ pf-heading-1-h3"><span data-pf-type="Text" class="sc-cHMHbD bwTmDt pf-310_">{{ section.settings.pf_0e67fbf2_value }}</span></h3></div></div></div><div class="sc-fBWQee eTKFIf pf-311_ pf-r pf-r-eh pf-lg-hide pf-md-hide" style="--s-xs:15px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-fPrdjK cvZVBM pf-312_"><div data-pf-type="Slideshow" class="sc-hHOBVR bEYJdW pf-313_"><div data-id="slider-966e0092-16f8-4ac4-afca-2265a2f154ff-all" class="pf-slider scrollfix" style="--ss-xs:1;--ss-sm:2;--ss-md:1;--ss-lg:1"><div class="pf-slide"><div class="sc-btwLGw feiLQD pf-314_" data-pf-type="SlideshowSlide"><div class="sc-fBWQee eTKFIf pf-315_ pf-r pf-r-eh" style="--s-xs:15px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-fPrdjK cvZVBM pf-316_ animate-grow"><h3 data-pf-type="Heading" class="sc-eNSrbD dsyRF pf-317_ pf-heading-1-h3"><span data-pf-type="Text" class="sc-cHMHbD bwTmDt pf-319_">{{ section.settings.pf_766e9fc3_value }}</span></h3><div data-pf-type="Image" class="sc-bJBfJu eIhGFX pf-320_ pf-image-1"><img src="https://cdn.shopif