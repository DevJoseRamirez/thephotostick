    var selectedId = offerConfig.defaultSelectedId || offerConfig.offers[0].id;
    var currentGalleryIndex = 0;

    function findOffer(id) {
      for (var i = 0; i < offerConfig.offers.length; i++) {
        if (offerConfig.offers[i].id === id) {
          return offerConfig.offers[i];
        }
      }
      return offerConfig.offers[0];
    }

    function findGalleryIndexById(id) {
      for (var i = 0; i < offerConfig.galleryImages.length; i++) {
        if (offerConfig.galleryImages[i].id === id) {
          return i;
        }
      }
      return 0;
    }

    function updateThumbActiveState(activeImageId) {
      var thumbs = root.querySelectorAll(".tps-thumb");

      for (var i = 0; i < thumbs.length; i++) {
        thumbs[i].classList.toggle(
          "is-active",
          thumbs[i].getAttribute("data-image-id") === activeImageId
        );
      }
    }

    function setMainImageByIndex(index) {
      if (!offerConfig.galleryImages.length || !mainImage) return;

      if (index < 0) index = offerConfig.galleryImages.length - 1;
      if (index >= offerConfig.galleryImages.length) index = 0;

      currentGalleryIndex = index;

      var image = offerConfig.galleryImages[currentGalleryIndex];

      mainImage.style.opacity = "0";

      window.setTimeout(function () {
        mainImage.src = image.src;
        mainImage.alt = image.alt || "ThePhotoStick Omni";
        mainImage.style.opacity = "1";
      }, 100);

      updateThumbActiveState(image.id);
    }

    function updateDynamicAxonBuyClass(offer) {
      if (!checkoutBtn || !offer || !offer.axonBuyClass) return;

      checkoutBtn.classList.remove(
        "axon-dyn-buy-16",
        "axon-dyn-buy-32",
        "axon-dyn-buy-64",
        "axon-dyn-buy-128",
        "axon-dyn-buy-256"
      );

      checkoutBtn.classList.add(offer.axonBuyClass);

      checkoutBtn.setAttribute("data-axon-selected-offer-id", offer.id || "");
      checkoutBtn.setAttribute("data-axon-selected-offer-title", offer.title || "");
      checkoutBtn.setAttribute("data-axon-buy-class", offer.axonBuyClass || "");
    }

    function selectOffer(id) {
      selectedId = id;

      var cards = root.querySelectorAll(".tps-offer-card");

      for (var i = 0; i < cards.length; i++) {
        cards[i].classList.toggle(
          "is-selected",
          cards[i].getAttribute("data-offer-id") === selectedId
        );
      }

      setMainImageByIndex(findGalleryIndexById(selectedId));
      updateDynamicAxonBuyClass(findOffer(selectedId));
    }

    function buildOffers() {
      if (!offerList) return;

      offerList.innerHTML = "";

      for (var i = 0; i < offerConfig.offers.length; i++) {
        (function (offer) {
          var card = document.createElement("button");
          card.type = "button";
          card.className = "tps-offer-card";
          card.setAttribute("data-offer-id", offer.id);
          card.setAttribute("aria-label", "Select " + offer.title);

          if (offer.id === selectedId) {
            card.classList.add("is-selected");
          }

          var cornerBadgeHtml = offer.cornerBadge
            ? '<div class="tps-corner-badge">' + offer.cornerBadge + "</div>"
            : "";

          card.innerHTML =
            cornerBadgeHtml +
            '<div class="tps-offer-img-wrap">' +
              '<img class="tps-offer-img" src="' + offer.productImage + '" alt="' + offer.title + '">' +
            '</div>' +
            '<div class="tps-offer-copy">' +
              '<div class="tps-offer-title-row">' +
                '<div class="tps-offer-title">' + offer.title + '</div>' +
                '<div class="tps-discount-badge">' + offer.discount + '</div>' +
              '</div>' +
              '<div class="tps-offer-subtitle">' + offer.subtitle + '</div>' +
            '</div>' +
            '<div class="tps-price-wrap">' +
              '<div class="tps-sale-price">' + offer.salePrice + '</div>' +
              '<div class="tps-compare-price">' + offer.comparePrice + '</div>' +
            '</div>';

          card.addEventListener("click", function () {
            selectOffer(offer.id);
          });

          offerList.appendChild(card);
        })(offerConfig.offers[i]);
      }
    }

    function buildThumbs() {
      if (!thumbsWrap) return;

      thumbsWrap.innerHTML = "";

      for (var i = 0; i < offerConfig.galleryImages.length; i++) {
        (function (image, index) {
          var thumbBtn = document.createElement("button");
          thumbBtn.type = "button";
          thumbBtn.className = "tps-thumb";
          thumbBtn.setAttribute("data-image-id", image.id);
          thumbBtn.setAttribute("aria-label", image.alt || "View product image");

          thumbBtn.innerHTML =
            '<img src="' + image.thumb + '" alt="' + (image.alt || "Product image") + '">';

          thumbBtn.addEventListener("click", function () {
            setMainImageByIndex(index);
          });

          thumbsWrap.appendChild(thumbBtn);
        })(offerConfig.galleryImages[i], i);
      }
    }

    function goToCheckout() {
      var selectedOffer = findOffer(selectedId);

      if (!selectedOffer || !selectedOffer.checkoutUrl) return;

      /*
        Axon/AppLovin note:
        We intentionally do not push a manual add_to_cart event here.
        Redirecting to the Shopify cart/checkout URL lets Shopify/Axon's native checkout
        tracking capture the add_to_cart and begin_checkout events with the selected
        marketing-product variant. The axon-dyn-buy-* classes remain for debugging
        and future GTM use, but no custom add_to_cart pixel is fired from this block.
      */
      window.location.href = selectedOffer.checkoutUrl;
    }

    buildOffers();
    buildThumbs();

    /*
      Load the default selected offer image first.
      Since defaultSelectedId is 64gb, the 64GB product image will show first.
      If the customer clicks another offer block, the main image swaps to that product image.
    */
    setMainImageByIndex(findGalleryIndexById(selectedId));
    updateDynamicAxonBuyClass(findOffer(selectedId));

    if (checkoutBtn) {
      checkoutBtn.addEventListener("click", goToCheckout);
    }

    if (prevBtn) {
      prevBtn.addEventListener("click", function () {
        setMainImageByIndex(currentGalleryIndex - 1);
      });
    }

    if (nextBtn) {
      nextBtn.addEventListener("click", function () {
        setMainImageByIndex(currentGalleryIndex + 1);
      });
    }
  })();
</script></div></div></div></div></div></div><div style="--overlay:rgba(255, 255, 255, 0.9)" data-section-id="pf-fc37" data-pf-type="Section" class="sc-cTTcKX hhkTci pf-309_ pf-color-scheme-1 pf-bg-lazy"><div class="sc-lmUbDS bYLvBD"></div><div style="--cw:1170px" class="sc-gplwNw fEopdE"><div class="sc-fBWQee eTKFIf pf-310_ pf-r pf-r-eh" style="--s-xs:0px;--s-sm:15px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-hGMjVM cQDYcy pf-311_"><p class="sc-ijDPxU cQGXXL pf-312_ pf-text-1" data-pf-type="Paragraph"><span data-pf-type="Text" class="sc-laNFUy ymAQo pf-314_">{{ section.settings.pf_75abb22a_value }}</span></p><h3 data-pf-type="Heading" class="sc-fsvrPk eoXWgL pf-315_ pf-heading-1-h3"><span data-pf-type="Text" class="sc-laNFUy ymAQo pf-317_">{{ section.settings.pf_cb47d642_value }}</span></h3></div></div></div><div class="sc-fBWQee eTKFIf pf-318_ pf-r pf-r-eh pf-lg-hide pf-md-hide" style="--s-xs:15px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-hGMjVM cQDYcy pf-319_"><div data-pf-type="Slideshow" class="sc-kWtorq ikZcgz pf-320_"><div data-id="slider-5a4c859c-aaf4-4e25-adb3-e3fb7411570e-all" class="pf-slider scrollfix" style="--ss-xs:1;--ss-sm:2;--ss-md:1;--ss-lg:1"><div class="pf-slide"><div class="sc-gFmZvT kXJbFG pf-321_" data-pf-type="SlideshowSlide"><div class="sc-fBWQee eTKFIf pf-322_ pf-r pf-r-eh" style="--s-xs:15px;position:relative" data-pf-type="Row"><div class="pf-c" style="--c-xs:12;--c-sm:12;--c-md:12;--c-lg:12"><div data-pf-type="Column" class="sc-hGMjVM cQDYcy pf-323_ animate-grow"><h3 data-pf-type="Heading" class="sc-fsvrPk eoXWgL pf-324_ pf-heading-1-h3"><span data-pf-type="Text" class="sc-laNFUy ymAQo pf-326_">{{ section.settings.pf_b7598982_value }}</span></h3><div data-pf-type="Image" class="sc-dGCntx fZorwe pf-327_ pf-image-1"><img src="https://cdn.shopify.