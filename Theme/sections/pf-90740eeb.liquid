    function scrollPct() {
      const doc = document.documentElement;
      const top = window.scrollY || doc.scrollTop || 0;
      const height = Math.max(doc.scrollHeight, document.body.scrollHeight);
      const view = window.innerHeight;
      const denom = Math.max(1, height - view);
      return Math.round((top / denom) * 100);
    }

    function anyInputFocused() {
      const a = document.activeElement;
      if (!a) return false;
      const tag = (a.tagName || '').toLowerCase();
      return tag === 'input' || tag === 'textarea' || a.isContentEditable;
    }

    function debounce(ms) {
      const now = Date.now();
      if (now - state.lastAttemptTs < ms) return true;
      state.lastAttemptTs = now;
      return false;
