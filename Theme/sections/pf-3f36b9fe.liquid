(function () {
  // Add immediate logging for debugging
  console.log("Script starting. DOM ready state:", document.readyState);
  console.log("Exit popup element exists:", !!document.getElementById('exit-popup'));

  // Check if popup was shown in this session
  if (localStorage.getItem('exitPopupShown')) {
    console.log("Popup already shown in this session");
    return;
  }

  // Wait for DOM to be ready
  function initializePopup() {
    const popup = document.getElementById('exit-popup');
    console.log("Attempting to initialize popup. Element found:", !!popup);

    if (!popup) {
      console.error('Exit popup element not found');
      return;
    }

    const content = popup.querySelector('.popup-content');
    const yesBtn = document.getElementById('yes-button');
    const noBtn = document.getElementById('exit-popup-cross');

    if (!content || !yesBtn || !noBtn) {
      console.error('Required popup elements missing', {
        content: !!content,
        yesBtn: !!yesBtn,
        noBtn: !!noBtn
      });
      return;
    }

    const isMobile = /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent);
    const pageLoadTime = Date.now();

    const state = {
      lastScrollTop: 0,
      scrollUpStartTime: 0,
      isScrollingUp: false,
      popupShown: false,
      inactivityTimer: null
    };

    // Styling
    popup.style.cssText = 'display:none; position:fixed; top:0; left:0; width:100%; height:100%; background-color:rgba(0,0,0,0.5); z-index:9999; justify-content:center; align-items:center;';
    content.style.cssText = 'background-color:rgba(255,255,255,0.9); padding:10px 20px 20px; border-radius:10px; text-align:center; max-width:400px; width:90%; position:absolute; top:50%; left:50%; transform:translate(-50%, -50%);';
    yesBtn.style.cssText = 'margin:10px 0; cursor:pointer; font-size:16px; background-color:#4CAF50; color:white; border:none; padding:10px 20px; border-radius:5px; text-align:center; text-decoration:none; display:inline-block; transition:background-color 0.3s;';
    noBtn.style.cssText = 'margin:10px 0; cursor:pointer; font-size:16px; text-decoration:underline; background:none; border:none; padding:0; color:#2196F3; display:block;';

    function showPopup() {
      if (!state.popupShown) {
        console.log("Showing popup");
        popup.style.display = 'flex';
        localStorage.setItem('exitPopupShown', 'true');
        state.popupShown = true;

        if (isMobile) {
          window.removeEventListener('scroll', checkScroll);
          clearTimeout(state.inactivityTimer);
        }
      }
    }

    function checkScroll() {
      const st = window.pageYOffset || document.documentElement.scrollTop;
      const currentTime = Date.now();
      const rapidScrollThreshold = 50; // pixels per 100ms

      if (st < state.lastScrollTop) {
        const scrollSpeed = (state.lastScrollTop - st) / (currentTime - (state.isScrollingUp ? state.scrollUpStartTime : currentTime)) * 100;

        if (!state.isScrollingUp) {
          state.isScrollingUp = true;
          state.scrollUpStartTime = currentTime;
        } else if ((scrollSpeed > rapidScrollThreshold && currentTime - state.scrollUpStartTime > 1000) || st === 0) {
          showPopup();
        }
      } else {
        state.isScrollingUp = false;
      }

      state.lastScrollTop = st <= 0 ? 0 : st;
      resetInactivityTimer();
    }

    function resetInactivityTimer() {
      clearTimeout(state.inactivityTimer);
      state.inactivityTimer = setTimeout(showPopup, 12000);
    }

    // Initialize after a short delay
    setTimeout(() => {
      console.log("Initializing exit intent. Is Mobile:", isMobile);

      if (isMobile) {
        window.addEventListener('scroll', checkScroll, { passive: true });
        resetInactivityTimer();

        ['touchstart', 'touchmove', 'keydown'].forEach(evt => {
          document.addEventListener(evt, resetInactivityTimer, { passive: true });
        });

        window.addEventListener('popstate', (e) => {
          e.preventDefault();
          showPopup();
        });

        window.history.pushState(null, '', window.location.href);
      } else {
        document.addEventListener('mouseleave', (e) => {
          console.log("Mouse left window. ClientY:", e.clientY);
          if (e.clientY < 0 && Date.now() - pageLoadTime > 5000 && !state.popupShown) {
            showPopup();
          }
        });
      }
    }, 5000);

    // Event handlers
    yesBtn.addEventListener('click', () => {
      try {
        window.location.href = 'https://thephotostick.myshopify.com/cart/42965172682888:1';
      } catch (error) {
        console.error('Error redirecting:', error);
      }
    });

    noBtn.addEventListener('click', (e) => {
      e.preventDefault();
      popup.style.display = 'none';
    });

    // Add hover effect
    yesBtn.addEventListener('mouseover', function () {
      this.style.backgroundColor = '#45a049';
    });
    yesBtn.addEventListener('mouseout', function () {
      this.style.backgroundColor = '#4CAF50';
    });

    // Responsive adjustments
    function adjustPopupPosition() {
      if (content) {
        content.style.top = '50%';
        content.style.left = '50%';
        content.style.transform = 'translate(-50%, -50%)';
      }
    }

    window.addEventListener('resize', adjustPopupPosition);
    window.addEventListener('orientationchange', adjustPopupPosition);

    // Add mobile styles
    const mobileStyle = document.createElement('style');
    mobileStyle.textContent = `
      @media (max-width: 480px) {
        #exit-popup .popup-content { 
          width: 95%; 
          max-height: 90vh;
          overflow-y: auto;
          -webkit-overflow-scrolling: touch;
        }
        #exit-popup #yes-button { 
          font-size: 14px; 
          padding: 8px 16px;
          -webkit-tap-highlight-color: transparent;
        }
        #exit-popup #exit-popup-cross { 
          font-size: 14px;
          padding: 8px;
        }
      }
    `;
    document.head.appendChild(mobileStyle);

    console.log("Exit intent script fully initialized");
  }

  // Initialize either when DOM is ready or immediately if already ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializePopup);
  } else {
    initializePopup();
  }
})();</script>
