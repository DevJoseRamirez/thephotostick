    function showPopup() {
      if (state.popupShown) return;
      popup.style.display = 'flex';
      localStorage.setItem('exitPopupShown', 'true');
      state.popupShown = true;
      if (isMobile) {
        window.removeEventListener('scroll', checkScroll);
        clearTimeout(state.inactivityTimer);
      }
    }

    function checkScroll() {
      const st = window.pageYOffset || document.documentElement.scrollTop;
      const currentTime = Date.now();
      const rapidScrollThreshold = 50;
      if (st < state.lastScrollTop) {
        const scrollSpeed = (state.lastScrollTop - st) / (currentTime - (state.isScrollingUp ? state.scrollUpStartTime : currentTime)) * 100;
        if (!state.isScrollingUp) {
          state.isScrollingUp = true;
          state.scrollUpStartTime = currentTime;
        } else if ((scrollSpeed > rapidScrollThreshold && currentTime - state.scrollUpStartTime > 1000) || st === 0) {
          if (shouldShowMobile()) showPopup();
        }
      } else {
        state.isScrollingUp = false;
      }
      state.lastScrollTop = st <= 0 ? 0 : st;
      resetInactivityTimer();
    }

    function resetInactivityTimer() {
      clearTimeout(state.inactivityTimer);
      state.inactivityTimer = setTimeout(() => { if (isMobile && shouldShowMobile()) showPopup(); }, 12000);
    }

    function hasMinSession(ms) { return Date.now() - pageLoadTime >= ms; }
    function isNearTop(px) { return (window.scrollY || document.documentElement.scrollTop || 0) <= px; }
    function shouldShowMobile() {
      if (!hasMinSession(MOBILE_MIN_SESSION_MS)) return false;
      if (scrollPct() < MOBILE_MIN_SCROLL_PCT) return false;
      if (!isNearTop(MOBILE_TOP_ZONE_PX)) return false;
      if (anyInputFocused()) return false;
      return true;
    }
    function shouldShowDesktop() {
      if (!hasMinSession(DESKTOP_MIN_SESSION_MS)) return false;
      if (scrollPct() < DESKTOP_MIN_SCROLL_PCT) return false;
      if (anyInputFocused()) return false;
      return true;
    }

    setTimeout(() => {
      if (isMobile) {
        window.addEventListener('scroll', checkScroll, { passive: true });
        resetInactivityTimer();
        ['touchstart', 'touchmove', 'keydown'].forEach(evt => { document.addEventListener(evt, resetInactivityTimer, { passive: true }); });
